server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 100m;
    auth_basic "DeepAudit 管理员";
    auth_basic_user_file /etc/nginx/.cds-htpasswd;
    location = /healthz { auth_basic off; access_log off; return 200 'ok'; }
    location / { try_files $uri $uri/ /index.html; }
    location /api/ {
        auth_basic off;
        proxy_pass ${DEEPAUDIT_BACKEND_URL}/api/;
        proxy_set_header Host $host;
        # Management HTTP Basic authenticates to nginx only. Forward upstream
        # Bearer tokens from the DeepAudit application unchanged.
        proxy_set_header Authorization $http_authorization;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }
}
