[Unit]
Description=Verified offsite backup retention with 90-day local history

[Service]
Type=oneshot
StateDirectory=llmgw
# Original policy retained sparse July dates indefinitely; only recent verified offsite receipts permit expiry.
ExecStart=/usr/local/sbin/prd-agent-verified-backup-retention --root /root/backups --receipt /var/lib/llmgw/offsite-backup-receipt.json --days 90 --execute --json-out /var/lib/llmgw/backup-retention-latest.json
StandardOutput=journal
StandardError=journal
