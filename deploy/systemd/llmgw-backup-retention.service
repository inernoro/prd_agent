[Unit]
Description=LLM Gateway backup retention

[Service]
Type=oneshot
StateDirectory=llmgw
ExecStart=/usr/local/sbin/llmgw-backup-retention --root /root/backups --max-removals 8 --execute --confirm DELETE_REDUNDANT_FULL_BACKUPS --json-out /var/lib/llmgw/backup-retention-latest.json
SuccessExitStatus=3
StandardOutput=journal
StandardError=journal
