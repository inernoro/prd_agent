# =============================================================
# PrdAgent Development Environment Variables
# Copy to .env and fill in actual values:  cp .env.template .env
# =============================================================

# --- Required ---

# MongoDB (password with special chars must be URL-encoded in connection string)
MONGODB_HOST=localhost
MONGODB_PASSWORD=
MongoDB__ConnectionString=mongodb://localhost:27017
MongoDB__DatabaseName=prdagent

# Redis
REDIS_HOST=localhost
REDIS_PASSWORD=
Redis__ConnectionString=localhost:6379

# JWT (must be >= 32 bytes)
Jwt__Secret=dev-only-change-me-32bytes-minimum!!

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# --- Optional: LLM ---

# LLM__ClaudeApiKey=sk-ant-xxx
# LLM__Model=claude-3-5-sonnet-20241022

# --- Production only: LLM Gateway serving topology ---
# 生产发布必须经 gateway upstream 使用 serving 主备，并配置一个长期存在的对象存储探针。
# PRD_AGENT_COMPOSE_PROJECT_NAME=prd_agent
# LLMGW_SERVE_BASE_URL=http://gateway
# LLMGW_READINESS_REQUIRE_ASSET_PROBE=true
# LLMGW_READINESS_ASSET_PROBE_KEY=

# --- Optional: Object Storage (tencentCos / cloudflareR2) ---
# ASSETS_PROVIDER 决定使用哪个存储后端，两者二选一

# Option A: Tencent COS
# ASSETS_PROVIDER=tencentCos
# TENCENT_COS_BUCKET=
# TENCENT_COS_REGION=
# TENCENT_COS_SECRET_ID=
# TENCENT_COS_SECRET_KEY=
# TENCENT_COS_PUBLIC_BASE_URL=
# TENCENT_COS_PREFIX=data

# Option B: Cloudflare R2
# ASSETS_PROVIDER=cloudflareR2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=
# R2_PREFIX=
# R2_ENDPOINT=

# --- Optional: Root Admin ---

# ROOT_ACCESS_USERNAME=
# ROOT_ACCESS_PASSWORD=

# --- Stable Smoke: copy names into untracked .env.stable-smoke.local ---
# 48 小时任务由 Codex 本地自动化执行。真实值只放本机忽略文件或安全存储，不提交到仓库。
# STABLE_SMOKE_CDS_BASE_URL=
# STABLE_SMOKE_CDS_AI_ACCESS_KEY=
# STABLE_SMOKE_CDS_USER=stsmk_cds
# STABLE_SMOKE_PROD_BASE_URL=https://map.ebcone.net
# 正式环境首选签名式破窗：私钥只放安全凭据库，服务端与仓库只保存公钥。
# STABLE_SMOKE_PROD_SIGNING_KEY_ID=
# STABLE_SMOKE_PROD_SIGNING_PRIVATE_KEY=
# 存量兼容，正式环境不建议继续使用全局超级密钥。
# STABLE_SMOKE_PROD_AI_ACCESS_KEY=
# STABLE_SMOKE_PROD_USER=stsmk_prod
# STABLE_SMOKE_NOTIFY_BASE_URL=https://map.ebcone.net
# STABLE_SMOKE_NOTIFY_SIGNING_KEY_ID=
# STABLE_SMOKE_NOTIFY_SIGNING_PRIVATE_KEY=
# STABLE_SMOKE_NOTIFY_AI_ACCESS_KEY=
# STABLE_SMOKE_NOTIFY_USER=stsmk_prod
# STABLE_SMOKE_NOTIFY_TARGET_USER_ID=
# STABLE_SMOKE_NOTIFY_TARGET_USERNAME=admin
# STABLE_SMOKE_NOTIFY_SOURCE=system-alert
# SYNTHETIC_LOGIN_ENABLED=false
# SYNTHETIC_LOGIN_ALLOWED_USERS=stsmk_cds,stsmk_prod
