<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.0" />
    <PackageReference Include="MongoDB.Driver" Version="2.29.0" />
    <!-- 显式引用 Bson：Driver 只在运行时把它带进来，直接在测试里写 BsonDocument 需要编译期引用 -->
    <PackageReference Include="MongoDB.Bson" Version="2.29.0" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PrdAgent.Core\PrdAgent.Core.csproj" />
    <ProjectReference Include="..\..\src\PrdAgent.Infrastructure\PrdAgent.Infrastructure.csproj" />
    <!--
      console-api 的纯判断（公开模型名怎么剥前缀、多模态判成哪种用途）需要**行为断言**，
      不是字面量断言：判据写在 minimal-api 的端点闭包旁边时，只能靠跑整条导入链路才验得到，
      而它们恰恰是「删掉之后编译照过、测试照绿」的那类逻辑。
      这是纯测试依赖，不改动生产接线：console-api 仍然是独立服务，不反向依赖本项目。
    -->
    <ProjectReference Include="..\..\..\llmgw\console-api\prd-llmgw.csproj" />
  </ItemGroup>

  <!-- MdsWriteRetiredFilter 是 MVC IActionFilter，要在测试里直接 new 出来跑，需要 MVC 类型 -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- console-api 的两个判据文件此前是 link 进来的；现在整个项目已被 ProjectReference 引入，
         再 link 一次会让同名类型出现两份（CS0436），删掉 link 由程序集提供。 -->
    <Compile Include="..\..\src\PrdAgent.Api\Services\InstanceIdentity.cs" Link="Services\InstanceIdentity.cs" />
    <!-- CDS 报告同步的「刷哪些库、各自从哪个源拉」判据。单独一个文件、只依赖 Core，
         就是为了能这样 link 进来跑；worker 本体拖着 BackgroundService/Mongo，搬不动。 -->
    <Compile Include="..\..\src\PrdAgent.Api\Services\CdsReportSyncTargets.cs" Link="Services\CdsReportSyncTargets.cs" />
    <Compile Include="..\..\src\PrdAgent.Api\Filters\MdsWriteRetiredFilter.cs" Link="Filters\MdsWriteRetiredFilter.cs" />
    <!-- arena.ai 榜单的解析器与分榜目录。同 CdsReportSyncTargets 的理由：这两个只依赖
         Core + HttpClient，link 进来就能直接跑；Worker 本体拖着 BackgroundService/Mongo，
         搬不动（守卫改为扫它的源码，见 ArenaLeaderboardFetcherTests）。 -->
    <Compile Include="..\..\src\PrdAgent.Api\Services\ModelLeaderboard\ArenaLeaderboardFetcher.cs" Link="Services\ModelLeaderboard\ArenaLeaderboardFetcher.cs" />
    <Compile Include="..\..\src\PrdAgent.Api\Services\ModelLeaderboard\ModelLeaderboardCatalog.cs" Link="Services\ModelLeaderboard\ModelLeaderboardCatalog.cs" />
    <Compile Include="..\..\src\PrdAgent.Api\Services\ModelLeaderboard\ModelLeaderboardScope.cs" Link="Services\ModelLeaderboard\ModelLeaderboardScope.cs" />
    <Compile Include="..\..\src\PrdAgent.Api\Services\ModelLeaderboard\ModelLicenseClassifier.cs" Link="Services\ModelLeaderboard\ModelLicenseClassifier.cs" />
  </ItemGroup>

</Project>
