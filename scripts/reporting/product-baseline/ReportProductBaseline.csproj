<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ProductApiProject Condition="'$(ProductApiProject)' == ''">$(MSBuildThisFileDirectory)../../../prd-api/src/PrdAgent.Api/PrdAgent.Api.csproj</ProductApiProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(FrozenBaselineSource)" Link="FrozenReportGenerationService.cs" />
    <ProjectReference Include="$(ProductApiProject)" />
  </ItemGroup>
</Project>
