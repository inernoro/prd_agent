div .flex.flex-col.h-full.relative.w-full [data-tour-id=webpages-card]
  input .hidden [type=file]
  div .flex.flex-col.h-full.overflow-hidden.relative
    div .overflow-hidden.relative.shrink-0 {height:140px}
      img .absolute.h-full.inset-0.w-full
      div .absolute.gap-1.inline-flex.items-center.left-2.top-2.z-20
        div .[@media(hover:none)]:flex.group-focus-within:flex.group-hover:flex.hidden
          div [data-no-drag=true aria-label=关联文档导航]
            button [aria-label=查看「多租户架构设计」的关联文档与所属合集 type=button]
              svg
              span
                "关联"
              svg
        span .inline-flex.items-center
          span .@[235px]:inline-flex.gap-1.hidden.items-center [aria-label=已分享]
            span .h-4.inline-flex.items-center.justify-center.w-4
              svg
          button .@[235px]:hidden.h-4.inline-flex.items-center.justify-center.w-4 [data-no-drag=true aria-label=查看状态：已分享 type=button]
            svg
      div .[@media(hover:none)]:block.absolute.bottom-[7px].hidden.right-[7px].z-20
        button .h-7.inline-flex.items-center.justify-center.max-sm:h-11.max-sm:min-h-11.max-sm:min-w-11.max-sm:w-11.min-h-7.min-w-[26px].pointer-events-auto.shrink-0.w-[26px] [data-no-drag=true aria-label=更多设置 type=button]
          svg
      button .absolute.group-focus-within:opacity-100.group-focus-within:pointer-events-auto.group-hover:opacity-100.group-hover:pointer-events-auto.h-7.inline-flex.items-center.justify-center.max-sm:h-11.max-sm:right-[-4px].max-sm:top-[-4px].max-sm:w-11.opacity-0.pointer-events-none.right-1.top-1.w-7.z-30 [data-no-drag=true aria-label=选择 type=button]
        span .group-hover:opacity-100.h-5.inline-flex.items-center.justify-center.w-5 {opacity:1}
      div .[@media(hover:hover)]:flex.absolute.bottom-1.gap-[5px].group-focus-within:opacity-100.group-focus-within:translate-y-0.group-hover:opacity-100.group-hover:translate-y-0.hidden.inset-x-0.items-center.opacity-0.pointer-events-none.translate-y-[6px].z-20 {padding:7px} [data-hoverbar=true]
        button .gap-1.h-7.inline-flex.items-center.justify-center.max-sm:h-11.max-sm:min-h-11.min-h-7.pointer-events-auto.px-[9px].shrink-0 [data-no-drag=true aria-label=预览 type=button]
          svg
          span .truncate
            "预览"
        button .gap-1.h-7.inline-flex.items-center.justify-center.max-sm:h-11.max-sm:min-h-11.max-sm:min-w-11.max-sm:w-11.min-h-7.min-w-[26px].pointer-events-auto.shrink-0.w-[26px] [data-no-drag=true aria-label=管理分享 · 1 type=button]
          svg
        div .flex.gap-[5px].items-center.ml-auto.shrink-0
          div .gap-[5px].hidden.items-center.sm:flex
            button .gap-1.h-7.inline-flex.items-center.justify-center.max-sm:h-11.max-sm:min-h-11.max-sm:min-w-11.max-sm:w-11.min-h-7.min-w-[26px].pointer-events-auto.shrink-0.w-[26px] [data-no-drag=true aria-label=编辑信息 type=button]
              svg
            button .gap-1.h-7.inline-flex.items-center.justify-center.max-sm:h-11.max-sm:min-h-11.max-sm:min-w-11.max-sm:w-11.min-h-7.min-w-[26px].pointer-events-auto.shrink-0.w-[26px] [data-no-drag=true aria-label=替换内容 type=button]
              svg
            button .gap-1.h-7.inline-flex.items-center.justify-center.max-sm:h-11.max-sm:min-h-11.max-sm:min-w-11.max-sm:w-11.min-h-7.min-w-[26px].pointer-events-auto.shrink-0.w-[26px] [data-no-drag=true aria-label=二维码 type=button]
              svg
          button .h-7.inline-flex.items-center.justify-center.max-sm:h-11.max-sm:min-h-11.max-sm:min-w-11.max-sm:w-11.min-h-7.min-w-[26px].pointer-events-auto.shrink-0.w-[26px] [data-no-drag=true aria-label=更多设置 type=button]
            svg
    div .flex.flex-1.flex-col {gap:5px;padding:10px 11px 11px}
      div .flex.gap-1.5.items-center.min-w-0 {min-height:20px}
        h3 .min-w-0.truncate
          "多租户架构设计"
        button .h-5.inline-flex.items-center.justify-center.ml-auto.shrink-0.w-5 [data-no-drag=true aria-label=查看网页详情 type=button]
          svg
      div .flex.gap-2.items-center.min-w-0
        span .shrink-0
          "11.0 KB"
        div .flex.flex-1.gap-2.items-center.justify-end.min-w-0.overflow-hidden [aria-label=网页统计]
          span .gap-1.inline-flex.items-center.min-w-0.overflow-hidden.whitespace-nowrap [aria-label=编辑次数暂不可用]
            svg .shrink-0
            span .truncate
              "—"
          span .gap-1.inline-flex.items-center.min-w-0.whitespace-nowrap [aria-label=全部访问（含作者）]
            svg .shrink-0
            span .truncate
