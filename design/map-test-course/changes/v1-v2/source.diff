+            </div>
+          ))}
+          {pending > 0 && live && <div className="lc-log-line lc-ink3"><span className="lc-t">…</span><span /><span>还有 {pending} 步</span></div>}
+        </div>
+      </div>
+      {live && (
+        <div className="flex flex-col gap-1 pt-2 text-[12px] lc-ink2">
+          <div className="flex gap-4 flex-wrap">
