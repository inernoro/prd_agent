+.lc-thumb[aria-current='true'] { background: var(--lc-hi-soft); color: var(--lc-ink); }
+.lc-thumb[data-in-lesson='true']::before { content: ''; position: absolute; left: -2px; top: 10px; bottom: 10px; width: 3px; border-radius: 3px; background: var(--lc-hi); }
+.lc-tool { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-width: 44px; min-height: 44px; padding: 0 10px; border-radius: 10px; font-size: 12.5px; font-weight: 600; color: var(--lc-ink-2); }
+.lc-tool:hover:not(:disabled) { background: var(--lc-hi-faint); color: var(--lc-ink); }
