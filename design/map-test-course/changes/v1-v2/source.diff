 /* 视频 */
-.lc-video-frame { position: relative; width: 100%; aspect-ratio: 16 / 9; border-radius: var(--radius-card, 12px); overflow: hidden; background: var(--bg-base); border: 1px solid var(--border-subtle); }
-.lc-video-frame video { width: 100%; height: 100%; display: block; object-fit: contain; background: var(--bg-base); }
-.lc-chapter { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 12px; border-radius: var(--radius-control, 9px); font-size: 12.5px; border: 1px solid var(--border-subtle); color: var(--text-secondary); white-space: nowrap; flex-shrink: 0; }
-.lc-chapter[aria-current='true'] { border-color: var(--accent-primary); color: var(--text-primary); }
-.lc-line { display: flex; gap: 10px; width: 100%; text-align: left; min-height: 44px; padding: 8px 10px; border-radius: var(--radius-control, 9px); font-size: 13px; line-height: 1.6; color: var(--text-secondary); transition: background 160ms ease, color 160ms ease; }
-.lc-line:hover { background: var(--bg-card-hover); }
-.lc-line[aria-current='true'] { color: var(--text-primary); background: var(--nested-block-bg); }
-.lc-line[aria-current='true'] .lc-line-time { color: var(--accent-primary); }
-.lc-timeline { position: relative; height: 6px; border-radius: 999px; background: var(--nested-block-bg); }
-.lc-timeline-fill { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 999px; background: var(--accent-primary); }
-.lc-timeline-mark { position: absolute; top: -3px; width: 2px; height: 12px; background: var(--text-muted); border-radius: 2px; }
+.lc-screen { position: relative; border-radius: 12px; overflow: hidden; background: var(--bg-base); box-shadow: 0 0 0 1px var(--lc-line); }
+.lc-screen video { display: block; width: 100%; height: 100%; object-fit: contain; background: var(--bg-base); }
+.lc-resume { display: inline-flex; align-items: center; gap: 10px; padding: 4px 6px 4px 12px; border-radius: 999px; background: var(--lc-hi-soft); font-size: 12.5px; }
+.lc-caption { font-size: 15px; line-height: 1.7; color: var(--lc-ink); min-height: 52px; transition: opacity 240ms ease; }
+.lc-cue { display: grid; grid-template-columns: 44px 1fr; gap: 8px; width: 100%; text-align: left; min-height: 44px; padding: 8px 10px; border-radius: 10px; font-size: 13px; line-height: 1.6; color: var(--lc-ink-2); transition: background 160ms ease, color 160ms ease; }
+.lc-cue:hover { background: var(--lc-hi-faint); }
