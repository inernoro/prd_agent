-.lc-pdf-page img { display: block; width: 100%; height: auto; }
+.lc-paper-stack { display: flex; flex-direction: column; align-items: center; gap: 18px; padding: 20px; }
+.lc-page { flex: none; width: 100%; max-width: 820px; aspect-ratio: 794 / 1123; border-radius: 4px; overflow: hidden; background: var(--bg-elevated); box-shadow: 0 1px 0 var(--lc-line), 0 10px 30px -18px var(--lc-ink); position: relative; }
