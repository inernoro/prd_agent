+.lc-note { margin: 18px 0; padding: 14px 16px 14px 18px; border-radius: 12px; background: var(--lc-hi-faint); border: 1px solid var(--lc-line); position: relative; }
+.lc-note::before { content: ''; position: absolute; left: 0; top: 14px; bottom: 14px; width: 3px; border-radius: 0 3px 3px 0; background: var(--lc-info); }
+.lc-note[data-tone='warn']::before { background: var(--lc-warn); }
+.lc-toc { display: flex; align-items: center; gap: 10px; width: 100%; min-height: 44px; padding: 0 12px; border-radius: 10px; font-size: 13px; color: var(--lc-ink-2); text-align: left; }
