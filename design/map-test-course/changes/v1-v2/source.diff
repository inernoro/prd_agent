+.lc-article li::before { content: ''; position: absolute; left: 4px; top: 0.78em; width: 8px; height: 2px; background: var(--lc-hi); }
+.lc-article pre { margin: 16px 0; padding: 16px 18px; border-radius: 12px; background: var(--lc-solid); border: 1px solid var(--lc-line); color: var(--lc-ink); font-size: 13px; line-height: 1.75; overflow-x: auto; }
+.lc-article figure img { width: 100%; border-radius: 12px; box-shadow: 0 0 0 1px var(--lc-line); }
