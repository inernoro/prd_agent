+.lc-log-line { display: grid; grid-template-columns: 44px 44px 1fr; gap: 6px; animation: lc-in 300ms ease both; }
+.lc-log-line .lc-t { color: var(--lc-ink-3); }
+.lc-log-tag { font-weight: 700; }
+.lc-log-tag[data-tone='ok'] { color: var(--lc-pass); }
+.lc-log-tag[data-tone='bad'] { color: var(--lc-fail); }
