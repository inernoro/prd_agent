+.lc-stage { flex: 1; min-height: 0; border-top: 1px solid var(--lc-line); }
+.lc-side { display: flex; flex-direction: column; gap: 12px; min-height: 0; }
+.lc-side-panel { display: flex; flex-direction: column; min-height: 0; flex: 1; }
