+.lc-page-no { position: absolute; right: 10px; bottom: 8px; font-family: var(--lc-mono); font-size: 11px; padding: 2px 6px; border-radius: 6px; background: var(--lc-solid); color: var(--lc-ink-2); }
+.lc-thumb { position: relative; display: grid; grid-template-columns: 52px 1fr; gap: 10px; align-items: center; width: 100%; min-height: 44px; padding: 6px; border-radius: 10px; text-align: left; font-size: 12.5px; color: var(--lc-ink-2); }
