+.lc-stamp-btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 44px; border-radius: 10px; border: 1.5px solid var(--lc-line-2); font-size: 13px; font-weight: 700; color: var(--lc-ink-2); transition: all 160ms ease; }
+.lc-stamp-btn:hover:not(:disabled) { color: var(--lc-ink); border-color: var(--lc-ink-3); }
+.lc-stamp-btn[aria-pressed='true'][data-kind='accept'] { color: var(--lc-pass); border-color: var(--lc-pass); background: color-mix(in srgb, var(--lc-pass) 10%, transparent); }
+.lc-stamp-btn[aria-pressed='true'][data-kind='reject'] { color: var(--lc-warn); border-color: var(--lc-warn); background: color-mix(in srgb, var(--lc-warn) 10%, transparent); }
+.lc-stamp { position: absolute; top: 12px; right: 12px; padding: 3px 10px; border: 2px solid currentColor; border-radius: 6px; font-size: 13px; font-weight: 800; letter-spacing: 0.2em; transform: rotate(-8deg); opacity: 0.9; animation: lc-stamp 320ms cubic-bezier(.2,.9,.3,1.4) both; pointer-events: none; }
+@keyframes lc-stamp { from { transform: rotate(-8deg) scale(1.8); opacity: 0; } to { transform: rotate(-8deg) scale(1); opacity: 0.9; } }
+.lc-reason-chip { display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px; border-radius: 10px; border: 1px dashed var(--lc-line-2); font-size: 12.5px; color: var(--lc-ink-2); text-align: left; }
+.lc-reason-chip:hover { border-style: solid; color: var(--lc-ink); }
+.lc-input { width: 100%; min-height: 44px; padding: 10px 12px; border-radius: 10px; background: var(--bg-input); border: 1px solid var(--lc-line); color: var(--lc-ink); font-size: 13.5px; line-height: 1.6; outline: none; }
+.lc-input:focus { border-color: var(--lc-hi); box-shadow: 0 0 0 3px var(--lc-hi-soft); }
+.lc-dock { position: sticky; bottom: 0; padding: 12px 14px; background: var(--lc-solid); border-top: 1px solid var(--lc-line); }
+.lc-board { display: grid; gap: 1px; background: var(--lc-line); border: 1px solid var(--lc-line); border-radius: 12px; overflow: hidden; }
+.lc-board > div { display: grid; grid-template-columns: 52px 1fr; gap: 10px; align-items: start; padding: 10px 12px; background: var(--lc-solid); font-size: 12.5px; line-height: 1.6; }
+.lc-verdict { font-family: var(--lc-mono); font-weight: 800; font-size: 11px; letter-spacing: 0.08em; }
+.lc-slip { background: var(--lc-solid); border: 1px solid var(--lc-line); border-radius: 4px 4px 14px 14px; padding: 16px 16px 14px; position: relative; }
+.lc-slip::before { content: ''; position: absolute; left: 0; right: 0; top: -6px; height: 6px; background: radial-gradient(circle at 6px 6px, transparent 4px, var(--lc-solid) 4.5px) 0 0 / 12px 6px repeat-x; }
+.lc-slip textarea { background: transparent; border: 0; border-top: 1px dashed var(--lc-line-2); border-radius: 0; padding: 12px 0 0; font-family: var(--lc-mono); font-size: 12.5px; line-height: 1.8; }
+.lc-slip textarea:focus { box-shadow: none; }
+.lc-cert { position: relative; padding: 24px 20px; border-radius: 16px; text-align: center; background: var(--lc-solid); border: 1px solid var(--lc-line); overflow: hidden; }
+.lc-cert::before { content: ''; position: absolute; inset: 8px; border: 1px solid var(--lc-line-2); border-radius: 10px; pointer-events: none; }
+.lc-seal { width: 76px; height: 76px; margin: 0 auto 10px; border-radius: 999px; border: 2px solid var(--lc-pass); color: var(--lc-pass); display: flex; align-items: center; justify-content: center; flex-direction: column; font-size: 11px; font-weight: 800; letter-spacing: 0.15em; transform: rotate(-10deg); animation: lc-stamp 420ms cubic-bezier(.2,.9,.3,1.4) both; }
+.lc-region { position: absolute; border: 2px solid currentColor; border-radius: 6px; }
+.lc-region[data-severity='P2'] { border-style: dashed; }
+.lc-region[data-selected='true'] { box-shadow: 0 0 0 4px var(--lc-hi-soft); }
+.lc-region-tag { position: absolute; top: -11px; left: -11px; width: 22px; height: 22px; border-radius: 6px; background: currentColor; display: inline-flex; align-items: center; justify-content: center; font-family: var(--lc-mono); font-size: 10.5px; font-weight: 800; }
+.lc-region-tag span { color: var(--bg-base); }
+.lc-skel { border-radius: 10px; background: linear-gradient(90deg, var(--lc-hi-faint), var(--lc-hi-soft), var(--lc-hi-faint)); background-size: 200% 100%; animation: lc-shimmer 1.4s ease-in-out infinite; }
+@keyframes lc-shimmer { from { background-position: 100% 0; } to { background-position: -100% 0; } }
+.lc-dotpulse { display: inline-block; width: 8px; height: 8px; border-radius: 99px; background: currentColor; animation: lc-blink 0.9s steps(1) infinite; }
 
+/* 课程卡（学习中心） */
+.lc-banner { position: relative; display: grid; grid-template-columns: 1fr; gap: 12px; width: 100%; padding: 18px 20px; text-align: left; border-radius: 16px; background: var(--lc-paper); border: 1px solid var(--lc-line); overflow: hidden; transition: border-color 200ms ease, transform 200ms ease; }
+.lc-banner:hover { border-color: var(--lc-line-2); transform: translateY(-1px); }
+.lc-banner-orb { position: absolute; right: -60px; top: -80px; width: 260px; height: 260px; border-radius: 999px; background: radial-gradient(circle, var(--lc-hi-soft), transparent 70%); pointer-events: none; }
+.lc-mini-metro { display: grid; grid-template-columns: repeat(var(--n), 1fr); position: relative; }
+.lc-mini-metro::before { content: ''; position: absolute; left: 10%; right: 10%; top: 9px; height: 2px; background: var(--lc-line); }
+.lc-mini-stop { position: relative; display: flex; flex-direction: column; align-items: center; gap: 6px; font-size: 11.5px; color: var(--lc-ink-3); }
+.lc-mini-stop i { width: 20px; height: 20px; border-radius: 99px; background: var(--lc-solid); border: 2px solid var(--lc-line-2); font-style: normal; font-family: var(--lc-mono); font-size: 10px; display: inline-flex; align-items: center; justify-content: center; color: var(--lc-ink-2); }
+.lc-mini-stop[data-next='true'] i { border-color: var(--lc-hi); color: var(--lc-hi); box-shadow: 0 0 0 4px var(--lc-hi-soft); }
+.lc-mini-stop[data-done='true'] i { border-color: var(--lc-pass); color: var(--lc-pass); }
+
+/* ---------- 手机 ---------- */
+@media (max-width: 767px) {
+  .lc-head { padding: 12px 12px 6px; }
+  .lc-title { font-size: 19px; }
+  .lc-metro { grid-template-columns: repeat(var(--n), 120px); overflow-x: auto; scrollbar-width: none; }
+  .lc-branch { white-space: nowrap; }
+  .lc-desk, .lc-bench { grid-template-columns: minmax(0, 1fr); }
+  .lc-lesson-no { font-size: 28px; }
+  .lc-sheet-head { padding: 10px 12px 0; }
+  .lc-article { padding: 16px 14px 32px; font-size: 15px; }
+}
