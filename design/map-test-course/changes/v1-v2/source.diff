+.lc-article { max-width: 720px; margin: 0 auto; padding: 26px 28px 40px; font-size: 15.5px; line-height: 1.9; color: var(--lc-ink-2); }
+.lc-article h2 { font-size: 20px; line-height: 1.35; color: var(--lc-ink); font-weight: 750; margin: 34px 0 10px; scroll-margin-top: 16px; display: flex; gap: 10px; align-items: baseline; }
