+.lc-cue-time { font-family: var(--lc-mono); font-size: 11px; color: var(--lc-ink-3); padding-top: 2px; }
+.lc-cue[aria-current='true'] .lc-cue-time { color: var(--lc-hi); }
+.lc-chapter-head { display: flex; align-items: center; gap: 8px; padding: 12px 10px 4px; font-size: 11.5px; font-weight: 700; color: var(--lc-ink-3); }
+.lc-chapter-head[data-active='true'] { color: var(--lc-ink); }
+.lc-chapter-head::after { content: ''; flex: 1; height: 1px; background: var(--lc-line); }
 
 /* PDF */
-.lc-thumb { display: block; width: 100%; padding: 6px; border-radius: var(--radius-field, 10px); border: 1px solid transparent; text-align: center; font-size: 11px; color: var(--text-muted); }
-.lc-thumb img { width: 100%; border-radius: 4px; border: 1px solid var(--border-subtle); display: block; }
-.lc-thumb[aria-current='true'] { border-color: var(--accent-primary); color: var(--text-primary); }
-.lc-thumb[data-in-lesson='true'] { background: var(--nested-block-bg); }
