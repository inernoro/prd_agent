+.lc-finish[data-finished='true'] { border-style: solid; border-color: var(--lc-pass); color: var(--lc-pass); }
+
+/* ---------- 票据（练习入口 / 工单） ---------- */
+.lc-ticket { position: relative; background: var(--lc-solid); border: 1px solid var(--lc-line); border-radius: var(--lc-r);
+  -webkit-mask: radial-gradient(circle 9px at 0 var(--cut, 50%), transparent 98%, black) left / 51% 100% no-repeat, radial-gradient(circle 9px at 100% var(--cut, 50%), transparent 98%, black) right / 51% 100% no-repeat;
+  mask: radial-gradient(circle 9px at 0 var(--cut, 50%), transparent 98%, black) left / 51% 100% no-repeat, radial-gradient(circle 9px at 100% var(--cut, 50%), transparent 98%, black) right / 51% 100% no-repeat; }
