+.lc-mini-stop i { width: 20px; height: 20px; border-radius: 99px; background: var(--lc-solid); border: 2px solid var(--lc-line-2); font-style: normal; font-family: var(--lc-mono); font-size: 10px; display: inline-flex; align-items: center; justify-content: center; color: var(--lc-ink-2); }
+.lc-mini-stop[data-next='true'] i { border-color: var(--lc-hi); color: var(--lc-hi); box-shadow: 0 0 0 4px var(--lc-hi-soft); }
+.lc-mini-stop[data-done='true'] i { border-color: var(--lc-pass); color: var(--lc-pass); }
+
+/* ---------- 手机 ---------- */
+@media (max-width: 767px) {
+  .lc-head { padding: 12px 12px 6px; }
+  .lc-title { font-size: 19px; }
+  .lc-metro { grid-template-columns: repeat(var(--n), 120px); overflow-x: auto; scrollbar-width: none; }
