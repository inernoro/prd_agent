+.lc-region-tag span { color: var(--bg-base); }
+.lc-skel { border-radius: 10px; background: linear-gradient(90deg, var(--lc-hi-faint), var(--lc-hi-soft), var(--lc-hi-faint)); background-size: 200% 100%; animation: lc-shimmer 1.4s ease-in-out infinite; }
+@keyframes lc-shimmer { from { background-position: 100% 0; } to { background-position: -100% 0; } }
+.lc-dotpulse { display: inline-block; width: 8px; height: 8px; border-radius: 99px; background: currentColor; animation: lc-blink 0.9s steps(1) infinite; }
+
+/* 课程卡（学习中心） */
+.lc-banner { position: relative; display: grid; grid-template-columns: 1fr; gap: 12px; width: 100%; padding: 18px 20px; text-align: left; border-radius: 16px; background: var(--lc-paper); border: 1px solid var(--lc-line); overflow: hidden; transition: border-color 200ms ease, transform 200ms ease; }
+.lc-banner:hover { border-color: var(--lc-line-2); transform: translateY(-1px); }
