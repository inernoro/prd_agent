+}
+@media (prefers-reduced-motion: reduce) {
+  .lc-flag, .lc-stamp, .lc-seal, .lc-work, .lc-log-line, .lc-skel, .lc-caret, .lc-dotpulse { animation: none; }
+}
+
+/* 手机：整页一起滚，舞台给定阅读高度，伴读栏限高 */
+.lc-mobile .lc-desk { display: flex; flex-direction: column; flex: none; }
