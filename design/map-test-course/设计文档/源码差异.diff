@@ -0,0 +1,53 @@
+import { BookOpenText, Bug, Eye, FileText, FlaskConical, Network, PlayCircle, type LucideIcon } from 'lucide-react';
+import type { FindingSeverity, LessonMediaKind, PracticeSkill } from './types';
+
+/* 课程页的类型映射统一放在这里（注册表模式），组件里不写 switch。 */
+
+export const MEDIA_REGISTRY: Record<LessonMediaKind, { label: string; icon: LucideIcon; unit: (n: number) => string }> = {
+  video: { label: '视频', icon: PlayCircle, unit: n => formatClock(n) },
+  pdf: { label: 'PDF 教材', icon: FileText, unit: n => `${n} 页` },
+  article: { label: '图文', icon: BookOpenText, unit: n => `${n} 分钟` },
+};
+
+export const MEDIA_ORDER: LessonMediaKind[] = ['video', 'pdf', 'article'];
+
+export const SKILL_REGISTRY: Record<PracticeSkill, { label: string; icon: LucideIcon; verb: string }> = {
+  review: { label: '代码评审', icon: Bug, verb: '评审' },
+  visual: { label: '视觉验收', icon: Eye, verb: '对照' },
+  unit: { label: '单元测试', icon: FlaskConical, verb: '生成测试' },
+  integration: { label: '联合测试', icon: Network, verb: '串链路' },
+};
+
+/* 严重级只用语义色 token，深浅主题各自成立 */
+export const SEVERITY_REGISTRY: Record<FindingSeverity, { label: string; color: string }> = {
+  P0: { label: 'P0 阻断', color: 'var(--accent-fg-error)' },
+  P1: { label: 'P1 严重', color: 'var(--accent-fg-warning)' },
+  P2: { label: 'P2 建议', color: 'var(--accent-fg-info)' },
+};
+
+export const PRACTICE_STEPS = [
+  { key: 'brief', label: '读任务' },
+  { key: 'review', label: 'Agent 检查' },
+  { key: 'triage', label: '判断与修复' },
+  { key: 'retest', label: '复测' },
+  { key: 'deliver', label: '交付' },
+] as const;
+
+export function formatClock(sec: number): string {
+  const s = Math.max(0, Math.round(sec));
+  return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
+}
+
+export function formatDuration(sec: number): string {
+  if (sec < 60) return `${Math.max(1, Math.round(sec))} 秒`;
+  const m = Math.round(sec / 60);
+  return m < 60 ? `${m} 分钟` : `${Math.floor(m / 60)} 小时 ${m % 60} 分钟`;
+}
+
+/* 逐条判断的说法随练习类型变化，判定口径相同：采纳 = 应用修复 / 保留；驳回必须写理由 */
+export const DECISION_REGISTRY: Record<PracticeSkill, { accept: string; reject: string; quickReasons: string[]; runLabel: string }> = {
+  review: { accept: '采纳修复', reject: '驳回', runLabel: '评审', quickReasons: ['前提不成立：函数没有共享状态', '属于风格偏好，不影响结果', '不在本次范围，已登记后续'] },
+  visual: { accept: '判为缺陷', reject: '在容差内', runLabel: '对照', quickReasons: ['偏差在 1px 容差内', '与设计稿一致', '不在本次改动范围'] },
+  unit: { accept: '保留这条测试', reject: '删掉这条', runLabel: '生成测试', quickReasons: ['依赖当前时间，结果不稳定', '与已有测试重复', '断言的是实现细节'] },
+  integration: { accept: '保留这条测试', reject: '删掉这条', runLabel: '串链路', quickReasons: ['打的是本地桩，不是真实部署', '与已有测试重复', '断言的是实现细节'] },
+};
diff --git a/prd-admin/src/pages/learning-course/RunConsole.tsx b/prd-admin/src/pages/learning-course/RunConsole.tsx
new file mode 100644
--- /dev/null
+++ b/prd-admin/src/pages/learning-course/RunConsole.tsx
@@ -0,0 +1,52 @@
+import { formatDuration } from './registry';
+import type { AgentRun, Finding, RetestResult } from './types';
+
+const TAG = { done: ['OK', 'ok'], running: ['RUN', 'run'], failed: ['FAIL', 'bad'], waiting: ['', ''] } as const;
+
+/* Agent 运行：阶段像日志一样逐行出现，发现的问题即时插入；跑完后复测给出逐项结果。模型名来自运行记录（网关返回）。 */
+export function RunConsole({ run, title, findings = [], retest }: { run: AgentRun; title: string; findings?: Finding[]; retest?: RetestResult }) {
+  const live = run.status === 'queued' || run.status === 'running';
+  const shown = run.stages.filter(s => s.status !== 'waiting');
+  const pending = run.stages.length - shown.length;
+  return (
+    <div className="flex flex-col gap-3" data-lc="agent-run" data-run-status={run.status}>
+      <div>
+        <div className="t-strong">{title}</div>
+        {run.model && <div className="t-meta t-mute lc-mono" data-lc="run-model">{run.model.model} · {run.model.platform}</div>}
+      </div>
+      {live && <div className="lc-meter"><span style={{ width: `${run.progress}%` }} /></div>}
+      <div className="lc-log" aria-live="polite">
+        {shown.map((s, i) => {
+          const [tag, tone] = TAG[s.status];
+          return (
+            <div key={s.key} className="lc-log-line" data-stage={s.key} data-stage-status={s.status}>
+              <span>{i + 1}/{run.stages.length}</span>
+              <span className="lc-log-tag" data-tone={tone}>{tag}</span>
+              <span style={{ color: 'var(--ink)' }}>{s.label}{s.detail ? <span className="t-mute"> · {s.detail}</span> : null}{s.status === 'running' && <span className="lc-caret" />}</span>
+            </div>
+          );
+        })}
+        {findings.map((f, i) => (
+          <div key={f.id} className="lc-log-line"><span>#{i + 1}</span><span className="lc-log-tag" data-tone="find">{f.severity}</span><span style={{ color: 'var(--ink)' }}>{f.title}</span></div>
+        ))}
+        {pending > 0 && live && <div className="lc-log-line"><span>…</span><span /><span>还有 {pending} 步</span></div>}
+      </div>
+      {live && (
+        <div className="t-meta t-mute">
+          {run.status === 'queued' ? '排队中' : `已用 ${formatDuration(run.elapsedSec)}`}{run.remainSec != null ? ` · 预计还需约 ${formatDuration(run.remainSec)}` : ''}{findings.length ? ` · 已发现 ${findings.length} 处` : ''}
+          <br />依据{run.estimateBasis}。可以先离开，回来会接着显示。
+        </div>
+      )}
+      {retest && run.status === 'done' && (
+        <div className="lc-checks" data-lc="retest-board">
+          {retest.checks.map(c => (
+            <div key={c.name}>
+              <span className="lc-verdict" style={{ color: c.status === 'pass' ? 'var(--pass)' : 'var(--fail)' }}>{c.status === 'pass' ? 'PASS' : 'FAIL'}</span>
+              <span>{c.name}{c.message && <span className="t-mute"> · {c.message}</span>}</span>
+            </div>
+          ))}
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/prd-admin/src/pages/learning-course/types.ts b/prd-admin/src/pages/learning-course/types.ts
new file mode 100644
--- /dev/null
+++ b/prd-admin/src/pages/learning-course/types.ts
@@ -0,0 +1,172 @@
+/* 课程与练习的数据契约（与 services/real/learningCourses.ts 的接口一一对应）。
+ * 业务判定（练习的对错、复测结果、经验值）全部由服务端给出，前端只展示。 */
+
+export type LessonMediaKind = 'video' | 'pdf' | 'article';
+export type LessonStatus = 'done' | 'current' | 'todo';
+export type PracticeSkill = 'review' | 'visual' | 'unit' | 'integration';
+
+export interface CourseSummary {
+  id: string;
+  title: string;
+  subtitle: string;
+  lessonCount: number;
+  /** 每课的短名，课程卡的迷你路线用 */
+  lessonShortTitles: string[];
+  minutes: number;
+  level: string;
+  /** 试运行：真人验收前为 true，学习中心课程卡显示「试运行」 */
+  wip?: boolean;
+  coverUrl?: string;
+  progress: { lessonsDone: number; practicesDone: number; nextLessonId?: string; nextLessonTitle?: string };
+}
+
+export interface VideoChapter { atSec: number; title: string }
+export interface TranscriptLine { atSec: number; text: string }
+
+export interface VideoMedia {
+  url: string;
+  posterUrl?: string;
+  durationSec: number;
+  chapters: VideoChapter[];
+  transcript: TranscriptLine[];
+  /** 上次看到的位置，服务端保存 */
+  resumeAtSec?: number;
+}
+
+export interface PdfMedia {
+  title: string;
+  /** 原文件，供下载 */
+  url: string;
+  sizeLabel: string;
+  /** 逐页图（服务端在上传时生成），手机与桌面显示一致 */
+  pages: { imageUrl: string; title: string }[];
+  /** 本课对应的页码区间（从 1 开始，含两端） */
+  lessonRange: [number, number];
+  lastPage?: number;
+}
+
+export type ArticleBlock =
+  | { type: 'h2'; id: string; text: string }
+  | { type: 'p'; text: string }
+  | { type: 'list'; items: string[] }
+  | { type: 'code'; lang: string; code: string; caption?: string }
+  | { type: 'callout'; tone: 'tip' | 'warn'; title: string; text: string }
+  | { type: 'figure'; imageUrl: string; caption: string };
+
+export interface ArticleMedia { readMinutes: number; blocks: ArticleBlock[] }
+
+export interface Lesson {
+  id: string;
+  index: number;
+  title: string;
+  summary: string;
+  /** 本课要点，三条以内，伴读栏常驻 */
+  keyPoints: string[];
+  minutes: number;
+  status: LessonStatus;
+  media: { video?: VideoMedia; pdf?: PdfMedia; article?: ArticleMedia };
+  /** 没有某种材料时的原因，按材料类型给出（例如本课没有视频，图文已覆盖） */
+  missingReason?: Partial<Record<LessonMediaKind, string>>;
+  practiceIds: string[];
+}
+
+export interface PracticeSummary {
+  id: string;
+  title: string;
+  skill: PracticeSkill;
+  minutes: number;
+  summary: string;
+  lessonIds: string[];
+  status: 'todo' | 'doing' | 'done';
+  /** 进行中时，回来能续上 */
+  runId?: string;
+}
+
+export interface Course {
+  id: string;
+  title: string;
+  subtitle: string;
+  wip?: boolean;
+  outcomes: string[];
+  lessons: Lesson[];
+  practices: PracticeSummary[];
+}
+
+/* ---------------- 练习 ---------------- */
+
+export interface CodeFile { path: string; lang: string; lines: string[] }
+
+export type PracticeSubject =
+  | { kind: 'code'; files: CodeFile[] }
+  | { kind: 'visual'; baselineUrl: string; actualUrl: string; viewport: string; theme: string };
+
+export interface Practice {
+  id: string;
+  courseId: string;
+  title: string;
+  skill: PracticeSkill;
+  minutes: number;
+  scenario: string;
+  /** 交付时要满足的条件 */
+  acceptance: string[];
+  /** 你要练的判断 */
+  focus: string;
+  agentLabel: string;
+  subject: PracticeSubject;
+}
+
+export type FindingSeverity = 'P0' | 'P1' | 'P2';
+
+export interface Finding {
+  id: string;
+  severity: FindingSeverity;
+  title: string;
+  /** 代码类：文件与行号；视觉类：截图上的区域（百分比） */
+  location: { file?: string; line?: number; region?: { x: number; y: number; w: number; h: number } };
+  evidence: string;
+  suggestion: string;
+  /** 采纳后要应用的修复（代码类为 diff 行） */
+  fix?: string[];
+}
+
+export type RunStageStatus = 'waiting' | 'running' | 'done' | 'failed';
+
+export interface AgentRun {
+  id: string;
+  purpose: 'review' | 'retest';
+  status: 'queued' | 'running' | 'done' | 'failed';
+  stages: { key: string; label: string; status: RunStageStatus; detail?: string }[];
+  progress: number;
+  elapsedSec: number;
+  remainSec?: number;
+  estimateBasis: string;
+  /** 来自网关返回，不在前端写死 */
+  model?: { model: string; platform: string };
+  failure?: { message: string; retryable: boolean };
+}
+
+export type Decision = 'accept' | 'reject';
+
+export interface RetestResult {
+  passed: boolean;
+  checks: { name: string; status: 'pass' | 'fail'; message?: string }[];
+  /** 判断出错时，逐条告诉学员错在哪 */
+  feedback: { findingId: string; message: string }[];
+  summary: string;
+}
+
+export interface PracticeRun {
+  id: string;
+  practiceId: string;
+  step: 'brief' | 'review' | 'triage' | 'retest' | 'deliver' | 'done';
+  attempt: number;
+  run?: AgentRun;
+  findings: Finding[];
+  decisions: Record<string, Decision>;
+  reasons: Record<string, string>;
+  retest?: RetestResult;
+  delivery?: { note: string; submittedAt?: string };
+  /** 服务端按本次判断与复测生成的交付说明草稿 */
+  deliveryDraft?: string;
+  outcome?: { xp: number; timeline: { at: string; text: string }[] };
+}
diff --git a/prd-admin/src/pages/learning-course/VideoLesson.tsx b/prd-admin/src/pages/learning-course/VideoLesson.tsx
new file mode 100644
--- /dev/null
+++ b/prd-admin/src/pages/learning-course/VideoLesson.tsx
@@ -0,0 +1,78 @@
+import { useEffect, useMemo, useRef, useState, type ReactNode } from 'react';
+import { RotateCcw } from 'lucide-react';
+import { Desk } from './Desk';
+import { formatClock } from './registry';
+import type { VideoMedia } from './types';
+
+/* 视频：主舞台放播放器与「此刻在讲什么」的大字幕；伴读栏是按章节分组的逐字稿，点一行跳到那一秒。
+ * 位置每 10 秒和暂停时保存；看到 90% 记为看完（由服务端判定）。 */
+export function VideoLesson({ video, head, keyPoints, ticket, onProgress }: {
+  video: VideoMedia; head: ReactNode; keyPoints: string[]; ticket: ReactNode;
+  onProgress: (positionSec: number, completed: boolean) => void;
+}) {
+  const ref = useRef<HTMLVideoElement>(null);
+  const list = useRef<HTMLDivElement>(null);
+  const [now, setNow] = useState(0);
+  const [resumed, setResumed] = useState<number | null>(null);
+  const saved = useRef(0);
+  const doneSent = useRef(false);
+
+  const idxAt = (arr: { atSec: number }[]) => arr.reduce((acc, x, i) => (x.atSec <= now + 0.05 ? i : acc), 0);
+  const line = useMemo(() => idxAt(video.transcript), [now, video.transcript]); // eslint-disable-line react-hooks/exhaustive-deps
+  const chapter = useMemo(() => idxAt(video.chapters), [now, video.chapters]); // eslint-disable-line react-hooks/exhaustive-deps
+
+  useEffect(() => {
+    const row = list.current?.querySelector<HTMLElement>(`[data-line="${line}"]`);
+    if (row && list.current) list.current.scrollTo({ top: Math.max(0, row.offsetTop - list.current.clientHeight / 3), behavior: 'smooth' });
+  }, [line]);
+
+  const seek = (sec: number) => { const el = ref.current; if (!el) return; el.currentTime = sec; setNow(sec); void el.play().catch(() => undefined); };
+  const save = (completed = false) => { const el = ref.current; if (!el) return; saved.current = el.currentTime; onProgress(el.currentTime, completed); };
+
+  const stage = (
+    <div className="h-full min-h-0 flex flex-col gap-4 p-6">
+      <div className="lc-screen-wrap flex-1 min-h-0 flex items-center justify-center">
+        <div className="lc-screen" style={{ aspectRatio: '16 / 9', height: '100%', maxWidth: '100%' }}>
+          <video ref={ref} src={video.url} poster={video.posterUrl} controls playsInline preload="metadata" data-lc="video"
+            onLoadedMetadata={() => { const at = video.resumeAtSec ?? 0; if (at > 1 && at < video.durationSec - 2 && ref.current) { ref.current.currentTime = at; setNow(at); setResumed(at); } }}
+            onTimeUpdate={e => {
+              const t = e.currentTarget.currentTime; setNow(t);
+              if (Math.abs(t - saved.current) >= 10) save();
+              if (!doneSent.current && t >= video.durationSec * 0.9) { doneSent.current = true; save(true); }
+            }}
+            onPause={() => save()} />
+        </div>
+      </div>
+      <div className="shrink-0 flex items-start gap-4 flex-wrap">
+        <div className="min-w-0 flex-1" style={{ minWidth: 260 }}>
+          <div className="t-meta t-mute">第 {chapter + 1} 章 · {video.chapters[chapter]?.title}</div>
+          <p className="lc-caption mt-1" key={line} aria-live="polite">{video.transcript[line]?.text}</p>
+        </div>
+        {resumed != null && (
+          <div className="lc-resume" data-lc="resume-note">
+            <span>已从上次看到的 {formatClock(resumed)} 继续</span>
+            <button type="button" className="lc-tool" onClick={() => { setResumed(null); seek(0); }}><RotateCcw size={13} />从头看</button>
+          </div>
+        )}
+      </div>
+    </div>
+  );
+
+  const companion = (
+    <div ref={list} data-lc="transcript">
+      {video.transcript.map((cue, i) => {
+        const ch = video.chapters.findIndex(c => c.atSec === cue.atSec);
+        return (
+          <div key={cue.atSec}>
+            {ch >= 0 && <div className="lc-chapter-head" data-active={ch === chapter}>{ch + 1}. {video.chapters[ch].title}</div>}
+            <button type="button" className="lc-cue" data-line={i} aria-current={i === line} onClick={() => seek(cue.atSec)}>
+              <span className="lc-cue-time lc-num">{formatClock(cue.atSec)}</span><span>{cue.text}</span>
+            </button>
+          </div>
+        );
+      })}
+    </div>
+  );
+
+  return <Desk ready="video" head={head} stage={stage} companionTitle={`逐字稿 · ${video.chapters.length} 章`} companionHint="点一行跳到那里" companion={companion} keyPoints={keyPoints} ticket={ticket} />;
+}
diff --git a/prd-admin/src/services/real/learningCourses.ts b/prd-admin/src/services/real/learningCourses.ts
new file mode 100644
