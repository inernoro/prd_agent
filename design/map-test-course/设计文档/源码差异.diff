diff --git a/prd-admin/src/pages/learning-course/AgentRunPanel.tsx b/prd-admin/src/pages/learning-course/AgentRunPanel.tsx
new file mode 100644
--- /dev/null
+++ b/prd-admin/src/pages/learning-course/AgentRunPanel.tsx
@@ -0,0 +1,48 @@
+import { CheckCircle2, Circle, CircleAlert, Cpu } from 'lucide-react';
+import { formatDuration } from './registry';
+import type { AgentRun, RunStageStatus } from './types';
+
+const STAGE_ICON: Record<RunStageStatus, (props: { size: number }) => JSX.Element> = {
+  waiting: ({ size }) => <Circle size={size} style={{ color: 'var(--text-muted)' }} />,
+  running: () => <span className="lc-pulse" />,
+  done: ({ size }) => <CheckCircle2 size={size} style={{ color: 'var(--accent-fg-success)' }} />,
+  failed: ({ size }) => <CircleAlert size={size} style={{ color: 'var(--accent-fg-error)' }} />,
+};
+
+/* Agent 运行面板：当前阶段、进度、已用与预计剩余、所用模型（来自网关）。任务在服务端跑，离开页面不中断。 */
+export function AgentRunPanel({ run, foundCount, title }: { run: AgentRun; foundCount?: number; title: string }) {
+  const running = run.status === 'queued' || run.status === 'running';
+  return (
+    <div className="lc-nested p-3 flex flex-col gap-2.5" data-lc="agent-run" data-run-status={run.status}>
+      <div className="flex items-center gap-2 flex-wrap">
+        <span className="text-[13.5px] font-semibold">{title}</span>
+        {run.model && (
+          <span className="inline-flex items-center gap-1.5 text-[11.5px] lc-muted lc-mono" data-lc="run-model"><Cpu size={12} />{run.model.model} · {run.model.platform}</span>
+        )}
+      </div>
+      <div className="flex flex-col">
+        {run.stages.map(s => {
+          const Icon = STAGE_ICON[s.status];
+          return (
+            <div key={s.key} className="lc-stage-row" data-stage={s.key} data-stage-status={s.status}>
+              <span className="lc-stage-icon"><Icon size={16} /></span>
+              <span style={{ color: s.status === 'waiting' ? 'var(--text-muted)' : 'var(--text-primary)' }}>{s.label}</span>
+              {s.detail && <span className="text-[12px] lc-muted truncate">{s.detail}</span>}
+            </div>
+          );
+        })}
+      </div>
+      {running && (
+        <>
+          <div className="lc-progress-track"><div className="lc-progress-fill" style={{ width: `${run.progress}%` }} /></div>
+          <div className="flex items-center gap-3 flex-wrap text-[12px] lc-secondary">
+            <span>{run.status === 'queued' ? '排队中' : `已用 ${formatDuration(run.elapsedSec)}`}</span>
+            {run.remainSec != null && <span>预计还需约 {formatDuration(run.remainSec)}</span>}
+            {foundCount != null && foundCount > 0 && <span style={{ color: 'var(--text-primary)' }}>已发现 {foundCount} 处</span>}
+          </div>
+          <div className="text-[11.5px] lc-muted">预计时间依据：{run.estimateBasis}。可以先离开，回来会接着显示。</div>
+        </>
+      )}
+    </div>
+  );
+}
diff --git a/prd-admin/src/pages/learning-course/ArticleLesson.tsx b/prd-admin/src/pages/learning-course/ArticleLesson.tsx
new file mode 100644
--- /dev/null
+++ b/prd-admin/src/pages/learning-course/ArticleLesson.tsx
@@ -0,0 +1,74 @@
+import { useEffect, useRef, useState } from 'react';
+import { AlertTriangle, CheckCircle2, Lightbulb } from 'lucide-react';
+import type { ArticleBlock, ArticleMedia } from './types';
+
+const CALLOUT_ICON = { tip: Lightbulb, warn: AlertTriangle } as const;
+
+function Block({ block }: { block: ArticleBlock }) {
+  switch (block.type) {
+    case 'h2': return <h2 id={block.id} data-toc={block.id}>{block.text}</h2>;
+    case 'p': return <p>{block.text}</p>;
+    case 'list': return <ul>{block.items.map(item => <li key={item}>{item}</li>)}</ul>;
+    case 'code': return <figure><pre className="lc-mono"><code>{block.code}</code></pre>{block.caption && <figcaption>{block.caption}</figcaption>}</figure>;
+    case 'figure': return <figure className="my-4"><img src={block.imageUrl} alt={block.caption} /><figcaption>{block.caption}</figcaption></figure>;
+    case 'callout': {
+      const Icon = CALLOUT_ICON[block.tone];
+      return (
+        <div className="lc-callout" data-tone={block.tone}>
+          <div className="flex items-center gap-2 font-semibold text-[14px]" style={{ color: 'var(--text-primary)' }}><Icon size={15} />{block.title}</div>
+          <div className="text-[14px] mt-1">{block.text}</div>
+        </div>
+      );
+    }
+  }
+}
+
+/* 图文：阅读栏 + 目录（随滚动高亮）。读到底记为读完。 */
+export function ArticleLesson({ article, onFinished }: { article: ArticleMedia; onFinished: () => void }) {
+  const toc = article.blocks.filter((b): b is Extract<ArticleBlock, { type: 'h2' }> => b.type === 'h2');
+  const [active, setActive] = useState<string | undefined>(toc[0]?.id);
+  const [finished, setFinished] = useState(false);
+  const box = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    const el = box.current;
+    if (!el) return;
+    const onScroll = () => {
+      let current: string | undefined = toc[0]?.id;
+      el.querySelectorAll<HTMLElement>('[data-toc]').forEach(h => { if (h.offsetTop - el.scrollTop <= 80) current = h.dataset.toc; });
+      setActive(current);
+      if (!finished && el.scrollTop + el.clientHeight >= el.scrollHeight - 24) { setFinished(true); onFinished(); }
+    };
+    el.addEventListener('scroll', onScroll, { passive: true });
+    return () => el.removeEventListener('scroll', onScroll);
+  }, [finished, onFinished, toc]);
+
+  return (
+    <div className="flex gap-4 h-full min-h-0" data-lc-ready="article">
+      <div ref={box} className="lc-scroll flex-1 lc-surface px-5 md:px-8 py-2" data-lc="article">
+        <article className="lc-article pb-8">
+          {article.blocks.map((b, i) => <Block key={i} block={b} />)}
+          <div className="flex items-center gap-2 text-[13px] mt-8 pt-3" style={{ borderTop: '1px solid var(--border-subtle)' }}>
+            <button type="button" className="inline-flex items-center gap-2 min-h-[44px] px-1" data-lc="article-end" data-finished={finished}
+              style={{ color: finished ? 'var(--accent-fg-success)' : 'var(--text-muted)' }}
+              onClick={() => { if (!finished) { setFinished(true); onFinished(); } }}>
+              <CheckCircle2 size={15} />{finished ? '本篇已读完，进度已记下' : '读到这里就算读完，也可以点这里记下'}
+            </button>
+          </div>
+        </article>
+      </div>
+      {toc.length > 1 && (
+        <nav className="hidden xl:flex flex-col shrink-0 pt-2" style={{ width: 180 }} aria-label="本篇目录">
+          <div className="lc-eyebrow px-2.5 pb-2">本篇目录</div>
+          {toc.map(h => (
+            <a key={h.id} className="lc-toc-link" aria-current={active === h.id} href={`#${h.id}`} onClick={e => {
+              e.preventDefault();
+              const target = box.current?.querySelector<HTMLElement>(`[data-toc="${h.id}"]`);
+              if (target && box.current) box.current.scrollTo({ top: target.offsetTop - 8, behavior: 'smooth' });
+            }}>{h.text}</a>
+          ))}
+        </nav>
+      )}
+    </div>
+  );
+}
diff --git a/prd-admin/src/pages/learning-course/CourseShelf.tsx b/prd-admin/src/pages/learning-course/CourseShelf.tsx
new file mode 100644
--- /dev/null
+++ b/prd-admin/src/pages/learning-course/CourseShelf.tsx
@@ -0,0 +1,65 @@
+import { useEffect, useState } from 'react';
+import { useNavigate } from 'react-router-dom';
+import { ArrowRight, Clock, FlaskConical, Layers } from 'lucide-react';
+import { listCourses } from '@/services/real/learningCourses';
+import type { CourseSummary } from './types';
+import './learningCourse.css';
+
+/* 学习中心的「课程」区：系统化的课程与短教程分开放，课程卡给出进度和下一课。 */
+export function CourseShelf() {
+  const navigate = useNavigate();
+  const [items, setItems] = useState<CourseSummary[] | null>(null);
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    void listCourses().then(res => (res.success ? setItems(res.data.items) : setError(res.error?.message ?? '课程列表没有加载出来')));
+  }, []);
+
+  if (error) return <div className="text-[12.5px] lc-muted">课程暂时没加载出来（{error}），稍后刷新即可，短教程不受影响。</div>;
+  if (!items || items.length === 0) return null;
+
+  return (
+    <section className="flex flex-col gap-3" data-tour-id="learning-courses" data-lc-ready="center" aria-label="课程">
+      <div className="flex items-center gap-2">
+        <Layers size={15} style={{ color: 'var(--accent-primary)' }} />
+        <span className="text-[14px] font-semibold" style={{ color: 'var(--text-primary)' }}>课程</span>
+        <span className="text-[11px]" style={{ color: 'var(--text-muted)' }}>成体系地学一项技能：视频、PDF 教材、图文，配练习 · {items.length} 门</span>
+      </div>
+      <div className="grid gap-3" style={{ gridTemplateColumns: 'repeat(auto-fill, minmax(min(100%, 560px), 1fr))' }}>
+        {items.map(c => {
+          const pct = Math.round((c.progress.lessonsDone / c.lessonCount) * 100);
+          const started = c.progress.lessonsDone > 0;
+          return (
+            <button
+              key={c.id}
+              type="button"
+              className="lc-practice-card"
+              style={{ padding: 0, overflow: 'hidden', minHeight: 148 }}
+              onClick={() => navigate(`/learning-center/courses/${encodeURIComponent(c.id)}${c.progress.nextLessonId ? `?lesson=${encodeURIComponent(c.progress.nextLessonId)}` : ''}`)}
+              data-lc="course-card"
+            >
+              {c.coverUrl && <img src={c.coverUrl} alt="" className="hidden sm:block shrink-0 object-cover" style={{ width: 200, height: '100%', minHeight: 156 }} />}
+              <span className="flex flex-col gap-2 p-3.5 min-w-0 flex-1">
+                <span className="flex items-center gap-2">
+                  <span className="text-[15px] font-bold truncate" style={{ color: 'var(--text-primary)' }}>{c.title}</span>
+                  {c.wip && <span className="text-[10.5px] px-2 py-0.5 rounded-full shrink-0" style={{ border: '1px solid var(--border-default)', color: 'var(--text-secondary)' }}>试运行</span>}
+                </span>
+                <span className="text-[12px] leading-relaxed line-clamp-2" style={{ color: 'var(--text-secondary)' }}>{c.subtitle}</span>
+                <span className="flex items-center gap-3 text-[11.5px]" style={{ color: 'var(--text-muted)' }}>
+                  <span className="inline-flex items-center gap-1"><Clock size={11} />{c.lessonCount} 课 · 约 {c.minutes} 分钟</span>
+                  <span className="inline-flex items-center gap-1"><FlaskConical size={11} />练习 {c.progress.practicesDone} 次完成</span>
+                </span>
+                <span className="flex items-center gap-3 mt-auto">
+                  <span className="lc-progress-track flex-1"><span className="lc-progress-fill block" style={{ width: `${Math.max(pct, 2)}%` }} /></span>
+                  <span className="text-[12px] font-semibold inline-flex items-center gap-1 shrink-0" style={{ color: 'var(--text-primary)' }}>
+                    {started ? '继续' : '开始'}{c.progress.nextLessonTitle ? `：${c.progress.nextLessonTitle}` : ''}<ArrowRight size={13} />
+                  </span>
+                </span>
+              </span>
+            </button>
+          );
+        })}
+      </div>
+    </section>
+  );
+}
diff --git a/prd-admin/src/pages/learning-course/FindingCard.tsx b/prd-admin/src/pages/learning-course/FindingCard.tsx
new file mode 100644
