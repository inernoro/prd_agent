+/* 检验台：课程与练习页的视觉语言（V2）。
+ * 颜色只取 tokens.css 语义变量，深浅主题各自成立；层次靠 color-mix 从语义色调出浓淡，不写颜色字面量。 */
+.lc-root {
+  --lc-ink: var(--text-primary);
+  --lc-ink-2: var(--text-secondary);
+  --lc-ink-3: var(--text-muted);
+  --lc-line: var(--border-subtle);
+  --lc-line-2: var(--border-default);
+  --lc-paper: var(--bg-card);
+  --lc-solid: var(--panel-solid);
+  --lc-hi: var(--accent-primary);
+  --lc-hi-soft: color-mix(in srgb, var(--accent-primary) 13%, transparent);
+  --lc-hi-faint: color-mix(in srgb, var(--accent-primary) 6%, transparent);
+  --lc-pass: var(--accent-fg-success);
+  --lc-fail: var(--accent-fg-error);
+  --lc-warn: var(--accent-fg-warning);
+  --lc-info: var(--accent-fg-info);
+  --lc-r: 14px;
+  --lc-mono: ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, monospace;
+  color: var(--lc-ink);
+  font-feature-settings: 'tnum';
+}
+.lc-mono { font-family: var(--lc-mono); }
+.lc-ink2 { color: var(--lc-ink-2); }
+.lc-ink3 { color: var(--lc-ink-3); }
+.lc-kicker { font-family: var(--lc-mono); font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--lc-ink-3); }
+.lc-scroll { min-height: 0; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; }
+.lc-panel { background: var(--lc-paper); border: 1px solid var(--lc-line); border-radius: var(--lc-r); }
+.lc-grid-bg { background-image: radial-gradient(var(--lc-line) 1px, transparent 1.3px); background-size: 18px 18px; background-position: -9px -9px; }
+.lc-link { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 8px; border-radius: 10px; color: var(--lc-ink-2); font-size: 13px; }
+.lc-link:hover { color: var(--lc-ink); background: var(--lc-hi-faint); }
+
+/* ---------- 动作按钮（以 design/Button 为载体，外观自定义） ---------- */
+.lc-act.map-btn { height: 44px; border-radius: 12px; padding: 0 18px; font-size: 13.5px; font-weight: 650; letter-spacing: 0.01em; border: 1px solid var(--lc-line-2); background: transparent; color: var(--lc-ink); box-shadow: none; transition: transform 140ms ease, background 160ms ease, border-color 160ms ease; }
+.lc-act.map-btn:hover:not(:disabled) { background: var(--lc-hi-faint); border-color: var(--lc-ink-3); transform: translateY(-1px); }
+.lc-act.map-btn.button-primary { background: var(--lc-hi); border-color: var(--lc-hi); color: var(--bg-base); }
+.lc-act.map-btn.button-primary:hover:not(:disabled) { background: var(--lc-hi); filter: brightness(1.06); }
+.lc-act.map-btn.button-ghost { border-color: transparent; color: var(--lc-ink-2); }
+.lc-act.map-btn:disabled { opacity: 0.42; }
+.lc-act .lc-act-key { font-family: var(--lc-mono); font-size: 11px; opacity: 0.7; }
+
+/* ---------- 课程页：头部与路线 ---------- */
+.lc-head { position: relative; padding: 12px 20px 6px; overflow: hidden; }
+.lc-head::after { content: ''; position: absolute; inset: auto 0 0 0; height: 1px; background: linear-gradient(90deg, transparent, var(--lc-line-2), transparent); }
+.lc-title { font-size: 24px; line-height: 1.2; font-weight: 750; letter-spacing: -0.01em; }
+.lc-stat { display: inline-flex; align-items: baseline; gap: 5px; font-size: 12px; color: var(--lc-ink-3); }
+.lc-stat b { font-family: var(--lc-mono); font-size: 15px; color: var(--lc-ink); font-weight: 650; }
+.lc-tag { display: inline-flex; align-items: center; height: 22px; padding: 0 8px; border-radius: 6px; font-size: 11px; font-weight: 600; border: 1px dashed var(--lc-line-2); color: var(--lc-ink-2); }
+
+.lc-metro { position: relative; display: grid; grid-template-columns: repeat(var(--n), minmax(120px, 1fr)); padding: 8px 0 2px; }
+.lc-metro-rail { position: absolute; top: 25px; height: 3px; border-radius: 3px; background: var(--lc-line); }
+.lc-metro-fill { position: absolute; top: 25px; height: 3px; border-radius: 3px; background: var(--lc-hi); transition: width 700ms cubic-bezier(.4,0,.2,1); }
+.lc-station { position: relative; display: flex; flex-direction: column; align-items: center; gap: 5px; min-height: 44px; padding: 0 6px 4px; text-align: center; border-radius: 12px; }
+.lc-station-dot { position: relative; z-index: 1; width: 36px; height: 36px; border-radius: 999px; display: inline-flex; align-items: center; justify-content: center; font-family: var(--lc-mono); font-size: 13px; font-weight: 700; background: var(--lc-solid); border: 2px solid var(--lc-line-2); color: var(--lc-ink-2); transition: transform 200ms ease, border-color 200ms ease; }
+.lc-station:hover .lc-station-dot { transform: scale(1.06); }
+.lc-station[data-status='done'] .lc-station-dot { border-color: var(--lc-pass); color: var(--lc-pass); }
+.lc-station[aria-current='true'] .lc-station-dot { border-color: var(--lc-hi); color: var(--lc-hi); box-shadow: 0 0 0 6px var(--lc-hi-soft); }
+.lc-station-name { font-size: 12.5px; font-weight: 600; line-height: 1.35; color: var(--lc-ink-2); max-width: 150px; }
+.lc-station[aria-current='true'] .lc-station-name { color: var(--lc-ink); }
+.lc-branch { display: inline-flex; align-items: center; gap: 6px; min-height: 26px; padding: 0 10px 0 8px; border-radius: 999px; font-size: 11.5px; color: var(--lc-ink-2); border: 1px solid var(--lc-line); background: var(--lc-solid); }
+.lc-branch::before { content: ''; width: 8px; height: 8px; transform: rotate(45deg); border-radius: 2px; background: var(--lc-hi); }
+.lc-branch[data-status='done']::before { background: var(--lc-pass); }
+.lc-branch:hover { border-color: var(--lc-hi); color: var(--lc-ink); }
+
+/* ---------- 课程页：书桌（主舞台 + 伴读栏） ---------- */
+.lc-desk { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 14px; min-height: 0; }
+.lc-sheet { display: flex; flex-direction: column; min-height: 0; overflow: hidden; }
+.lc-sheet-head { display: flex; align-items: flex-end; gap: 16px; padding: 14px 18px 0; flex-wrap: wrap; }
+.lc-lesson-no { font-family: var(--lc-mono); font-size: 40px; line-height: 0.9; font-weight: 700; color: var(--lc-hi); letter-spacing: -0.03em; }
+.lc-ruler { display: flex; gap: 2px; margin-left: auto; overflow-x: auto; scrollbar-width: none; }
+.lc-ruler-tab { position: relative; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; min-height: 48px; padding: 0 14px; font-size: 13px; font-weight: 650; color: var(--lc-ink-2); white-space: nowrap; border-radius: 10px 10px 0 0; flex-shrink: 0; }
+.lc-ruler-tab small { font-family: var(--lc-mono); font-size: 11px; font-weight: 500; color: var(--lc-ink-3); }
+.lc-ruler-tab::after { content: ''; position: absolute; left: 12px; right: 12px; bottom: 0; height: 3px; border-radius: 3px 3px 0 0; background: transparent; transition: background 200ms ease; }
+.lc-ruler-tab[aria-pressed='true'] { color: var(--lc-ink); background: var(--lc-hi-faint); }
+.lc-ruler-tab[aria-pressed='true']::after { background: var(--lc-hi); }
+.lc-ruler-tab:disabled { cursor: not-allowed; color: var(--lc-ink-3); }
+.lc-ruler-tab:disabled span { text-decoration: line-through; text-decoration-color: var(--lc-line-2); }
+.lc-stage { flex: 1; min-height: 0; border-top: 1px solid var(--lc-line); }
+.lc-side { display: flex; flex-direction: column; gap: 12px; min-height: 0; }
+.lc-side-panel { display: flex; flex-direction: column; min-height: 0; flex: 1; }
+.lc-side-head { display: flex; align-items: center; justify-content: space-between; padding: 12px 14px 8px; }
+
+/* 视频 */
+.lc-screen { position: relative; border-radius: 12px; overflow: hidden; background: var(--bg-base); box-shadow: 0 0 0 1px var(--lc-line); }
+.lc-screen video { display: block; width: 100%; height: 100%; object-fit: contain; background: var(--bg-base); }
+.lc-resume { display: inline-flex; align-items: center; gap: 10px; padding: 4px 6px 4px 12px; border-radius: 999px; background: var(--lc-hi-soft); font-size: 12.5px; }
+.lc-caption { font-size: 15px; line-height: 1.7; color: var(--lc-ink); min-height: 52px; transition: opacity 240ms ease; }
+.lc-cue { display: grid; grid-template-columns: 44px 1fr; gap: 8px; width: 100%; text-align: left; min-height: 44px; padding: 8px 10px; border-radius: 10px; font-size: 13px; line-height: 1.6; color: var(--lc-ink-2); transition: background 160ms ease, color 160ms ease; }
+.lc-cue:hover { background: var(--lc-hi-faint); }
+.lc-cue[aria-current='true'] { color: var(--lc-ink); background: var(--lc-hi-soft); }
+.lc-cue-time { font-family: var(--lc-mono); font-size: 11px; color: var(--lc-ink-3); padding-top: 2px; }
+.lc-cue[aria-current='true'] .lc-cue-time { color: var(--lc-hi); }
+.lc-chapter-head { display: flex; align-items: center; gap: 8px; padding: 12px 10px 4px; font-size: 11.5px; font-weight: 700; color: var(--lc-ink-3); }
+.lc-chapter-head[data-active='true'] { color: var(--lc-ink); }
+.lc-chapter-head::after { content: ''; flex: 1; height: 1px; background: var(--lc-line); }
+
+/* PDF */
+.lc-paper-stack { display: flex; flex-direction: column; align-items: center; gap: 18px; padding: 20px; }
+.lc-page { flex: none; width: 100%; max-width: 820px; aspect-ratio: 794 / 1123; border-radius: 4px; overflow: hidden; background: var(--bg-elevated); box-shadow: 0 1px 0 var(--lc-line), 0 10px 30px -18px var(--lc-ink); position: relative; }
+.lc-page img { display: block; width: 100%; height: 100%; object-fit: contain; }
+.lc-page-no { position: absolute; right: 10px; bottom: 8px; font-family: var(--lc-mono); font-size: 11px; padding: 2px 6px; border-radius: 6px; background: var(--lc-solid); color: var(--lc-ink-2); }
+.lc-thumb { position: relative; display: grid; grid-template-columns: 52px 1fr; gap: 10px; align-items: center; width: 100%; min-height: 44px; padding: 6px; border-radius: 10px; text-align: left; font-size: 12.5px; color: var(--lc-ink-2); }
+.lc-thumb img { width: 52px; aspect-ratio: 794 / 1123; border-radius: 3px; box-shadow: 0 0 0 1px var(--lc-line); }
+.lc-thumb:hover { background: var(--lc-hi-faint); }
+.lc-thumb[aria-current='true'] { background: var(--lc-hi-soft); color: var(--lc-ink); }
+.lc-thumb[data-in-lesson='true']::before { content: ''; position: absolute; left: -2px; top: 10px; bottom: 10px; width: 3px; border-radius: 3px; background: var(--lc-hi); }
+.lc-tool { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-width: 44px; min-height: 44px; padding: 0 10px; border-radius: 10px; font-size: 12.5px; font-weight: 600; color: var(--lc-ink-2); }
+.lc-tool:hover:not(:disabled) { background: var(--lc-hi-faint); color: var(--lc-ink); }
+.lc-tool:disabled { opacity: 0.4; cursor: not-allowed; }
+.lc-tool[aria-pressed='true'] { color: var(--lc-ink); background: var(--lc-hi-soft); }
+
+/* 图文 */
+.lc-article { max-width: 720px; margin: 0 auto; padding: 26px 28px 40px; font-size: 15.5px; line-height: 1.9; color: var(--lc-ink-2); }
+.lc-article h2 { font-size: 20px; line-height: 1.35; color: var(--lc-ink); font-weight: 750; margin: 34px 0 10px; scroll-margin-top: 16px; display: flex; gap: 10px; align-items: baseline; }
+.lc-article h2 .lc-h-no { font-family: var(--lc-mono); font-size: 13px; color: var(--lc-hi); }
+.lc-article p { margin: 12px 0; }
+.lc-article .lc-lede { font-size: 17px; line-height: 1.8; color: var(--lc-ink); }
+.lc-article ul { margin: 12px 0; padding: 0; list-style: none; }
+.lc-article li { position: relative; padding-left: 22px; margin: 6px 0; }
+.lc-article li::before { content: ''; position: absolute; left: 4px; top: 0.78em; width: 8px; height: 2px; background: var(--lc-hi); }
+.lc-article pre { margin: 16px 0; padding: 16px 18px; border-radius: 12px; background: var(--lc-solid); border: 1px solid var(--lc-line); color: var(--lc-ink); font-size: 13px; line-height: 1.75; overflow-x: auto; }
+.lc-article figure img { width: 100%; border-radius: 12px; box-shadow: 0 0 0 1px var(--lc-line); }
+.lc-article figcaption { font-size: 12.5px; color: var(--lc-ink-3); margin-top: 8px; }
+.lc-note { margin: 18px 0; padding: 14px 16px 14px 18px; border-radius: 12px; background: var(--lc-hi-faint); border: 1px solid var(--lc-line); position: relative; }
+.lc-note::before { content: ''; position: absolute; left: 0; top: 14px; bottom: 14px; width: 3px; border-radius: 0 3px 3px 0; background: var(--lc-info); }
+.lc-note[data-tone='warn']::before { background: var(--lc-warn); }
+.lc-toc { display: flex; align-items: center; gap: 10px; width: 100%; min-height: 44px; padding: 0 12px; border-radius: 10px; font-size: 13px; color: var(--lc-ink-2); text-align: left; }
+.lc-toc .lc-mono { font-size: 11px; color: var(--lc-ink-3); }
+.lc-toc:hover { background: var(--lc-hi-faint); }
+.lc-toc[aria-current='true'] { color: var(--lc-ink); background: var(--lc-hi-soft); }
+.lc-toc[aria-current='true'] .lc-mono { color: var(--lc-hi); }
+.lc-finish { display: flex; align-items: center; gap: 12px; width: 100%; min-height: 56px; margin-top: 28px; padding: 0 16px; border-radius: 12px; border: 1.5px dashed var(--lc-line-2); font-size: 13.5px; color: var(--lc-ink-2); text-align: left; transition: border-color 200ms ease, color 200ms ease; }
+.lc-finish[data-finished='true'] { border-style: solid; border-color: var(--lc-pass); color: var(--lc-pass); }
+
+/* ---------- 票据（练习入口 / 工单） ---------- */
+.lc-ticket { position: relative; background: var(--lc-solid); border: 1px solid var(--lc-line); border-radius: var(--lc-r);
+  -webkit-mask: radial-gradient(circle 9px at 0 var(--cut, 50%), transparent 98%, black) left / 51% 100% no-repeat, radial-gradient(circle 9px at 100% var(--cut, 50%), transparent 98%, black) right / 51% 100% no-repeat;
+  mask: radial-gradient(circle 9px at 0 var(--cut, 50%), transparent 98%, black) left / 51% 100% no-repeat, radial-gradient(circle 9px at 100% var(--cut, 50%), transparent 98%, black) right / 51% 100% no-repeat; }
+.lc-perf { height: 0; border-top: 1.5px dashed var(--lc-line-2); margin: 0 14px; }
+.lc-pick { display: grid; grid-template-columns: 34px 1fr auto; gap: 10px; align-items: center; width: 100%; min-height: 52px; padding: 8px 10px; border-radius: 10px; text-align: left; }
+.lc-pick:hover { background: var(--lc-hi-faint); }
+.lc-pick[data-active='true'] { background: var(--lc-hi-soft); }
+.lc-glyph { width: 34px; height: 34px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--lc-line-2); color: var(--lc-hi); }
+
+/* ---------- 练习页：检验台 ---------- */
+.lc-steps { display: flex; align-items: center; gap: 0; }
+.lc-step { display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--lc-ink-3); white-space: nowrap; }
+.lc-step i { font-style: normal; font-family: var(--lc-mono); font-size: 11px; width: 24px; height: 24px; border-radius: 7px; display: inline-flex; align-items: center; justify-content: center; border: 1.5px solid var(--lc-line-2); }
+.lc-step[data-state='current'] { color: var(--lc-ink); font-weight: 650; }
+.lc-step[data-state='current'] i { border-color: var(--lc-hi); background: var(--lc-hi); color: var(--bg-base); }
+.lc-step[data-state='done'] i { border-color: var(--lc-pass); color: var(--lc-pass); }
+.lc-step-line { width: 28px; height: 2px; margin: 0 8px; border-radius: 2px; background: var(--lc-line); }
+.lc-step-line[data-done='true'] { background: var(--lc-pass); }
+.lc-bench { display: grid; grid-template-columns: minmax(0, 1fr) 420px; gap: 14px; min-height: 0; }
+.lc-object { display: flex; flex-direction: column; min-height: 0; overflow: hidden; }
+.lc-object-head { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-bottom: 1px solid var(--lc-line); }
+.lc-file { display: inline-flex; align-items: center; gap: 8px; min-height: 36px; padding: 0 12px; border-radius: 9px; font-family: var(--lc-mono); font-size: 12.5px; color: var(--lc-ink-2); }
+.lc-file[aria-current='true'] { color: var(--lc-ink); background: var(--lc-hi-soft); }
+.lc-code { font-family: var(--lc-mono); font-size: 13px; line-height: 1.8; padding: 8px 0 24px; }
+.lc-code-row { display: grid; grid-template-columns: 34px 46px minmax(0, 1fr); transition: background 220ms ease; }
+.lc-code-row[data-flag='true'] { background: var(--lc-hi-faint); }
+.lc-code-row[data-selected='true'] { background: var(--lc-hi-soft); box-shadow: inset 3px 0 0 var(--lc-hi); }
+.lc-code-row .lc-ln { text-align: right; padding-right: 14px; color: var(--lc-ink-3); user-select: none; }
+.lc-code-row .lc-src { white-space: pre; padding-right: 18px; color: var(--lc-ink); }
+.lc-code-row[data-diff='del'] { background: color-mix(in srgb, var(--lc-fail) 9%, transparent); }
+.lc-code-row[data-diff='del'] .lc-src { color: var(--lc-fail); text-decoration: line-through; text-decoration-thickness: 1px; }
+.lc-code-row[data-diff='add'] { background: color-mix(in srgb, var(--lc-pass) 10%, transparent); }
+.lc-code-row[data-diff='add'] .lc-src { color: var(--lc-pass); }
+.lc-flag { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; margin: 2px 6px; border-radius: 6px; font-family: var(--lc-mono); font-size: 10.5px; font-weight: 800; color: var(--bg-base); background: currentColor; animation: lc-pop 380ms cubic-bezier(.2,.9,.3,1.3) both; }
+.lc-flag span { color: var(--bg-base); }
+@keyframes lc-pop { from { transform: scale(0.3); opacity: 0; } to { transform: none; opacity: 1; } }
+.lc-console { display: flex; flex-direction: column; min-height: 0; overflow: hidden; }
+.lc-console-head { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-bottom: 1px solid var(--lc-line); }
+.lc-log { font-family: var(--lc-mono); font-size: 12px; line-height: 1.75; padding: 10px 14px; color: var(--lc-ink-2); }
+.lc-log-line { display: grid; grid-template-columns: 44px 44px 1fr; gap: 6px; animation: lc-in 300ms ease both; }
+.lc-log-line .lc-t { color: var(--lc-ink-3); }
+.lc-log-tag { font-weight: 700; }
+.lc-log-tag[data-tone='ok'] { color: var(--lc-pass); }
+.lc-log-tag[data-tone='bad'] { color: var(--lc-fail); }
+.lc-log-tag[data-tone='run'] { color: var(--lc-hi); }
+.lc-log-tag[data-tone='find'] { color: var(--lc-warn); }
+.lc-caret { display: inline-block; width: 7px; height: 13px; margin-left: 4px; vertical-align: -2px; background: var(--lc-hi); animation: lc-blink 1s steps(1) infinite; }
+@keyframes lc-blink { 50% { opacity: 0; } }
+@keyframes lc-in { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
+.lc-meter { position: relative; height: 4px; background: var(--lc-line); overflow: hidden; }
+.lc-meter > span { position: absolute; inset: 0 auto 0 0; background: var(--lc-hi); transition: width 600ms ease; }
+
+.lc-work { position: relative; padding: 14px; border-radius: 12px; background: var(--lc-solid); border: 1px solid var(--lc-line); animation: lc-in 360ms ease both; }
+.lc-work[data-selected='true'] { border-color: var(--lc-hi); box-shadow: 0 0 0 3px var(--lc-hi-soft); }
+.lc-sev { display: inline-flex; align-items: center; height: 20px; padding: 0 7px; border-radius: 5px; font-family: var(--lc-mono); font-size: 10.5px; font-weight: 800; color: var(--bg-base); }
+.lc-stamp-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
+.lc-stamp-btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 44px; border-radius: 10px; border: 1.5px solid var(--lc-line-2); font-size: 13px; font-weight: 700; color: var(--lc-ink-2); transition: all 160ms ease; }
+.lc-stamp-btn:hover:not(:disabled) { color: var(--lc-ink); border-color: var(--lc-ink-3); }
+.lc-stamp-btn[aria-pressed='true'][data-kind='accept'] { color: var(--lc-pass); border-color: var(--lc-pass); background: color-mix(in srgb, var(--lc-pass) 10%, transparent); }
+.lc-stamp-btn[aria-pressed='true'][data-kind='reject'] { color: var(--lc-warn); border-color: var(--lc-warn); background: color-mix(in srgb, var(--lc-warn) 10%, transparent); }
+.lc-stamp { position: absolute; top: 12px; right: 12px; padding: 3px 10px; border: 2px solid currentColor; border-radius: 6px; font-size: 13px; font-weight: 800; letter-spacing: 0.2em; transform: rotate(-8deg); opacity: 0.9; animation: lc-stamp 320ms cubic-bezier(.2,.9,.3,1.4) both; pointer-events: none; }
+@keyframes lc-stamp { from { transform: rotate(-8deg) scale(1.8); opacity: 0; } to { transform: rotate(-8deg) scale(1); opacity: 0.9; } }
+.lc-reason-chip { display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px; border-radius: 10px; border: 1px dashed var(--lc-line-2); font-size: 12.5px; color: var(--lc-ink-2); text-align: left; }
+.lc-reason-chip:hover { border-style: solid; color: var(--lc-ink); }
+.lc-input { width: 100%; min-height: 44px; padding: 10px 12px; border-radius: 10px; background: var(--bg-input); border: 1px solid var(--lc-line); color: var(--lc-ink); font-size: 13.5px; line-height: 1.6; outline: none; }
+.lc-input:focus { border-color: var(--lc-hi); box-shadow: 0 0 0 3px var(--lc-hi-soft); }
+.lc-dock { position: sticky; bottom: 0; padding: 12px 14px; background: var(--lc-solid); border-top: 1px solid var(--lc-line); }
+.lc-board { display: grid; gap: 1px; background: var(--lc-line); border: 1px solid var(--lc-line); border-radius: 12px; overflow: hidden; }
+.lc-board > div { display: grid; grid-template-columns: 52px 1fr; gap: 10px; align-items: start; padding: 10px 12px; background: var(--lc-solid); font-size: 12.5px; line-height: 1.6; }
+.lc-verdict { font-family: var(--lc-mono); font-weight: 800; font-size: 11px; letter-spacing: 0.08em; }
+.lc-slip { background: var(--lc-solid); border: 1px solid var(--lc-line); border-radius: 4px 4px 14px 14px; padding: 16px 16px 14px; position: relative; }
+.lc-slip::before { content: ''; position: absolute; left: 0; right: 0; top: -6px; height: 6px; background: radial-gradient(circle at 6px 6px, transparent 4px, var(--lc-solid) 4.5px) 0 0 / 12px 6px repeat-x; }
+.lc-slip textarea { background: transparent; border: 0; border-top: 1px dashed var(--lc-line-2); border-radius: 0; padding: 12px 0 0; font-family: var(--lc-mono); font-size: 12.5px; line-height: 1.8; }
+.lc-slip textarea:focus { box-shadow: none; }
+.lc-cert { position: relative; padding: 24px 20px; border-radius: 16px; text-align: center; background: var(--lc-solid); border: 1px solid var(--lc-line); overflow: hidden; }
+.lc-cert::before { content: ''; position: absolute; inset: 8px; border: 1px solid var(--lc-line-2); border-radius: 10px; pointer-events: none; }
