+++ b/prd-admin/src/pages/learning-course/FindingTicket.tsx
@@ -0,0 +1,37 @@
+import { Check, X } from 'lucide-react';
+import { DECISION_REGISTRY, SEVERITY_REGISTRY } from './registry';
+import type { Decision, Finding, PracticeSkill } from './types';
+
+/* 一条意见：证据在前、建议在后；学员决定采纳或驳回，驳回要写理由（常用理由一键填入）。 */
+export function FindingTicket({ index, finding, skill, decision, reason, feedback, selected, locked, onSelect, onDecide, onReason }: {
+  index: number; finding: Finding; skill: PracticeSkill; decision?: Decision; reason?: string; feedback?: string;
+  selected: boolean; locked: boolean; onSelect: () => void; onDecide: (d: Decision) => void; onReason: (t: string) => void;
+}) {
+  const sev = SEVERITY_REGISTRY[finding.severity];
+  const words = DECISION_REGISTRY[skill];
+  const where = finding.location.file ? `${finding.location.file.split('/').pop()}:${finding.location.line}` : '截图标注区';
+  return (
+    <article className="lc-work flex flex-col gap-3" data-selected={selected} data-lc="finding" data-finding={finding.id}>
+      <header className="flex items-baseline gap-3 t-meta">
+        <span className="lc-num t-mute">{index}</span>
+        <span className="lc-sev" style={{ color: sev.color }}>{sev.label}</span>
+        <button type="button" className="lc-mono t-mute hover:underline" onClick={onSelect} data-qc-touch-exempt>{where}</button>
+        {decision && <span className="ml-auto t-strong" style={{ color: decision === 'accept' ? 'var(--pass)' : 'var(--warn)' }}>{decision === 'accept' ? '已采纳' : '已驳回'}</span>}
+      </header>
+      <h3 className="lc-work-title t-strong">{finding.title}</h3>
+      <p className="t-mute">{finding.evidence}</p>
+      <p><span className="t-mute">建议：</span>{finding.suggestion}</p>
+      {feedback && <p className="pl-3" style={{ borderLeft: '2px solid var(--warn)' }} data-lc="finding-feedback"><span style={{ color: 'var(--warn)' }}>复测看到：</span>{feedback}</p>}
+      <div className="lc-choice-row" role="group" aria-label={`第 ${index} 条的判断`}>
+        <button type="button" className="lc-choice" data-kind="accept" aria-pressed={decision === 'accept'} disabled={locked} onClick={() => onDecide('accept')} data-lc="decide-accept"><Check size={15} />{words.accept}</button>
+        <button type="button" className="lc-choice" data-kind="reject" aria-pressed={decision === 'reject'} disabled={locked} onClick={() => onDecide('reject')} data-lc="decide-reject"><X size={15} />{words.reject}</button>
+      </div>
+      {decision === 'reject' && (
+        <div className="flex flex-col gap-2">
+          <input className="lc-input" placeholder="写一句理由，复测时会核对它" value={reason ?? ''} disabled={locked} onChange={e => onReason(e.target.value)} data-lc="reject-reason" />
+          {!locked && <div className="flex gap-2 flex-wrap">{words.quickReasons.map(q => <button key={q} type="button" className="lc-reason-chip" onClick={() => onReason(q)}>{q}</button>)}</div>}
+        </div>
+      )}
+    </article>
+  );
+}
diff --git a/prd-admin/src/pages/learning-course/learningCourse.css b/prd-admin/src/pages/learning-course/learningCourse.css
new file mode 100644
--- /dev/null
+++ b/prd-admin/src/pages/learning-course/learningCourse.css
@@ -0,0 +1,202 @@
+/* 课程与练习页样式（V3）。
+ * 排版刻度写死：字号只用 12 / 14 / 16 / 20 / 28（代码 13），字重只用 400 / 600；
+ * 颜色只取 tokens.css 语义变量，强调色只给「当前」与主按钮；层次靠留白与细分隔线，不靠底色和装饰。 */
+.lc-root {
+  --fs-meta: 12px; --fs-ui: 14px; --fs-read: 16px; --fs-title: 20px; --fs-display: 28px; --fs-code: 13px;
+  --lh-meta: 18px; --lh-ui: 22px; --lh-read: 28px; --lh-title: 28px; --lh-display: 36px;
+  --ink: var(--text-primary); --ink-2: var(--text-muted);
+  --line: var(--border-faint); --line-2: var(--border-subtle);
+  --hi: var(--accent-primary);
+  --hi-wash: color-mix(in srgb, var(--accent-primary) 8%, transparent);
+  --pass: var(--accent-fg-success); --fail: var(--accent-fg-error); --warn: var(--accent-fg-warning); --info: var(--accent-fg-info);
+  --mono: ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, monospace;
+  color: var(--ink); font-size: var(--fs-ui); line-height: var(--lh-ui); font-weight: 400;
+}
+.lc-root h1, .lc-root h2, .lc-root h3 { font-weight: 600; }
+.t-meta, .lc-kicker { font-size: var(--fs-meta); line-height: var(--lh-meta); }
+.t-ui { font-size: var(--fs-ui); line-height: var(--lh-ui); }
+.t-read { font-size: var(--fs-read); line-height: var(--lh-read); }
+.t-title { font-size: var(--fs-title); line-height: var(--lh-title); }
+.t-display { font-size: var(--fs-display); line-height: var(--lh-display); letter-spacing: -0.01em; }
+.t-strong { font-weight: 600; }
+.t-mute, .lc-kicker, .lc-ink2, .lc-ink3 { color: var(--ink-2); }
+.lc-mono { font-family: var(--mono); }
+.lc-num { font-variant-numeric: tabular-nums; }
+.lc-scroll { min-height: 0; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; }
+.lc-panel { background: var(--bg-card); border: 1px solid var(--line-2); border-radius: 12px; }
+.lc-rule { height: 1px; background: var(--line-2); border: 0; }
+.lc-link { display: inline-flex; align-items: center; gap: 4px; min-height: 44px; color: var(--ink-2); }
+.lc-link:hover { color: var(--ink); }
+
+/* 按钮：以 design/Button 为载体 */
+.lc-act.map-btn { height: 44px; padding: 0 20px; border-radius: 10px; font-size: var(--fs-ui); font-weight: 600; border: 1px solid var(--line-2); background: transparent; color: var(--ink); box-shadow: none; transition: background 150ms ease, border-color 150ms ease; }
+.lc-act.map-btn:hover:not(:disabled) { background: var(--hi-wash); }
+.lc-act.map-btn.button-primary { background: var(--hi); border-color: var(--hi); color: var(--bg-base); }
+.lc-act.map-btn.button-primary:hover:not(:disabled) { background: var(--hi); opacity: 0.92; }
+.lc-act.map-btn.button-ghost { border-color: transparent; color: var(--ink-2); padding: 0 12px; }
+.lc-act.map-btn:disabled { opacity: 0.4; }
+
+/* ---------- 课程页 ---------- */
+.lc-head { padding: 20px 24px 8px; }
+.lc-metro { position: relative; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); margin-top: 16px; }
+.lc-metro-rail, .lc-metro-fill { position: absolute; top: 21px; height: 2px; }
+.lc-metro-rail { background: var(--line-2); }
+.lc-metro-fill { background: var(--hi); transition: width 600ms ease; }
+.lc-station { position: relative; display: flex; flex-direction: column; align-items: center; gap: 8px; min-height: 44px; padding: 16px 4px 8px; color: var(--ink-2); font-size: var(--fs-meta); line-height: var(--lh-meta); }
