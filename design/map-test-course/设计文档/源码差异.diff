diff --git a/prd-admin/src/pages/learning-course/ArticleLesson.tsx b/prd-admin/src/pages/learning-course/ArticleLesson.tsx
new file mode 100644
--- /dev/null
+++ b/prd-admin/src/pages/learning-course/ArticleLesson.tsx
@@ -0,0 +1,71 @@
+import { useEffect, useRef, useState, type ReactNode } from 'react';
+import { AlertTriangle, CheckCircle2, Lightbulb } from 'lucide-react';
+import { Desk } from './Desk';
+import type { ArticleBlock, ArticleMedia } from './types';
+
+const NOTE_ICON = { tip: Lightbulb, warn: AlertTriangle } as const;
+
+function Block({ block, first, no }: { block: ArticleBlock; first: boolean; no?: number }) {
+  switch (block.type) {
+    case 'h2': return <h2 id={block.id} data-toc={block.id} data-no={no}>{block.text.replace(/^[一二三四五六七八九十]+、/, '')}</h2>;
+    case 'p': return <p className={first ? 'lc-lede' : undefined}>{block.text}</p>;
+    case 'list': return <ul>{block.items.map(x => <li key={x}>{x}</li>)}</ul>;
+    case 'code': return <figure><pre className="lc-mono"><code>{block.code}</code></pre>{block.caption && <figcaption>{block.caption}</figcaption>}</figure>;
+    case 'figure': return <figure className="my-5"><img src={block.imageUrl} alt={block.caption} /><figcaption>{block.caption}</figcaption></figure>;
+    case 'callout': {
+      const Icon = NOTE_ICON[block.tone];
+      return <div className="lc-note" data-tone={block.tone}><div className="flex items-center gap-2 t-strong"><Icon size={16} />{block.title}</div><div className="mt-1 t-mute">{block.text}</div></div>;
+    }
+  }
+}
+
+/* 图文：舒展的阅读栏；伴读栏是编号目录与阅读进度。读到底或点文末记为读完。 */
+export function ArticleLesson({ article, head, keyPoints, ticket, onFinished }: { article: ArticleMedia; head: ReactNode; keyPoints: string[]; ticket: ReactNode; onFinished: () => void }) {
+  const toc = article.blocks.filter((b): b is Extract<ArticleBlock, { type: 'h2' }> => b.type === 'h2');
+  const [active, setActive] = useState<string | undefined>(toc[0]?.id);
+  const [pct, setPct] = useState(0);
+  const [finished, setFinished] = useState(false);
+  const box = useRef<HTMLDivElement>(null);
+  const finish = () => { if (!finished) { setFinished(true); onFinished(); } };
+
+  useEffect(() => {
+    const el = box.current; if (!el) return;
+    const onScroll = () => {
+      let cur: string | undefined = toc[0]?.id;
+      el.querySelectorAll<HTMLElement>('[data-toc]').forEach(h => { if (h.offsetTop - el.scrollTop <= 90) cur = h.dataset.toc; });
+      setActive(cur);
+      const max = el.scrollHeight - el.clientHeight;
+      setPct(max > 0 ? Math.round((el.scrollTop / max) * 100) : 100);
+      if (el.scrollTop + el.clientHeight >= el.scrollHeight - 24) finish();
+    };
+    el.addEventListener('scroll', onScroll, { passive: true });
+    return () => el.removeEventListener('scroll', onScroll);
+  });
+
+  let h = 0;
+  const stage = (
+    <div ref={box} className="lc-scroll h-full" data-lc="article">
+      <article className="lc-article">
+        {article.blocks.map((b, i) => <Block key={i} block={b} first={i === 0} no={b.type === 'h2' ? ++h : undefined} />)}
+        <button type="button" className="lc-finish" data-lc="article-end" data-finished={finished} onClick={finish}>
+          <CheckCircle2 size={18} />{finished ? '本篇已读完，进度已记下' : '读到这里就算读完，也可以点这里记下'}
+        </button>
+      </article>
+    </div>
+  );
+  const companion = (
+    <div className="flex flex-col gap-0.5">
+      {toc.map(t => (
+        <button key={t.id} type="button" className="lc-toc" aria-current={active === t.id} onClick={() => {
+          const target = box.current?.querySelector<HTMLElement>(`[data-toc="${t.id}"]`);
+          if (target && box.current) box.current.scrollTo({ top: target.offsetTop - 12, behavior: 'smooth' });
+        }}>{t.text.replace(/^[一二三四五六七八九十]+、/, '')}</button>
+      ))}
+      <div className="px-3 pt-3">
+        <div className="flex justify-between t-meta lc-ink3 mb-1.5"><span>已读</span><span className="lc-num">{finished ? 100 : pct}%</span></div>
+        <div className="lc-meter" style={{ borderRadius: 4 }}><span style={{ width: `${finished ? 100 : pct}%` }} /></div>
+      </div>
+    </div>
+  );
+  return <Desk ready="article" head={head} stage={stage} companionTitle={`本篇 · ${article.readMinutes} 分钟`} companionHint={`${toc.length} 节`} companion={companion} keyPoints={keyPoints} ticket={ticket} />;
+}
diff --git a/prd-admin/src/pages/learning-course/CourseMetro.tsx b/prd-admin/src/pages/learning-course/CourseMetro.tsx
new file mode 100644
--- /dev/null
+++ b/prd-admin/src/pages/learning-course/CourseMetro.tsx
@@ -0,0 +1,21 @@
+import type { Course, Lesson } from './types';
+
+/* 课程路线：五课是一条线上的五站，已学实心、当前站强调色，轨道填到当前站。练习入口在右侧伴读栏。 */
+export function CourseMetro({ course, activeId, onLesson }: { course: Course; activeId: string; onLesson: (l: Lesson) => void }) {
+  const n = course.lessons.length;
+  const activeIdx = Math.max(0, course.lessons.findIndex(l => l.id === activeId));
+  const reached = Math.max(activeIdx, course.lessons.reduce((m, l, i) => (l.status === 'done' ? i : m), -1));
+  const half = 50 / n;
+  return (
+    <nav className="lc-metro" style={{ ['--n' as string]: n }} aria-label="课程路线" data-tour-id="course-lessons">
+      <span className="lc-metro-rail" style={{ left: `${half}%`, right: `${half}%` }} aria-hidden />
+      <span className="lc-metro-fill" style={{ left: `${half}%`, width: `${(reached / n) * 100}%` }} aria-hidden />
+      {course.lessons.map(lesson => (
+        <button key={lesson.id} type="button" className="lc-station" data-status={lesson.status} aria-current={lesson.id === activeId} data-lc="lesson-row" data-lesson={lesson.id} onClick={() => onLesson(lesson)}>
+          <span className="lc-station-dot" />
+          <span>{lesson.index}. {lesson.title.split('：')[0]}</span>
+        </button>
+      ))}
+    </nav>
+  );
+}
diff --git a/prd-admin/src/pages/learning-course/CourseShelf.tsx b/prd-admin/src/pages/learning-course/CourseShelf.tsx
new file mode 100644
--- /dev/null
+++ b/prd-admin/src/pages/learning-course/CourseShelf.tsx
@@ -0,0 +1,45 @@
+import { useEffect, useState } from 'react';
+import { useNavigate } from 'react-router-dom';
+import { ArrowRight } from 'lucide-react';
+import { listCourses } from '@/services/real/learningCourses';
+import type { CourseSummary } from './types';
+import './learningCourse.css';
+
+/* 学习中心的「课程」区：每门课一张卡，路线标出学到哪、下一课是哪。 */
+export function CourseShelf() {
+  const navigate = useNavigate();
+  const [items, setItems] = useState<CourseSummary[] | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  useEffect(() => { void listCourses().then(res => (res.success ? setItems(res.data.items) : setError(res.error?.message ?? '课程列表没有加载出来'))); }, []);
+
+  if (error) return <div className="t-meta" style={{ color: 'var(--text-muted)' }}>课程暂时没加载出来（{error}），稍后刷新即可，短教程不受影响。</div>;
+  if (!items?.length) return null;
+  return (
+    <section className="lc-root flex flex-col gap-3" data-tour-id="learning-courses" data-lc-ready="center" aria-label="课程">
+      <div className="flex items-baseline gap-3"><h2 className="t-strong">课程</h2><span className="t-meta t-mute">成体系地学一项技能，视频、PDF 教材、图文任选，配动手练习</span></div>
+      {items.map(c => {
+        const nextIdx = c.progress.nextLessonId ? Number(c.progress.nextLessonId.replace(/\D/g, '')) - 1 : c.lessonCount;
+        return (
+          <button key={c.id} type="button" className="lc-banner" data-lc="course-card"
+            onClick={() => navigate(`/learning-center/courses/${encodeURIComponent(c.id)}${c.progress.nextLessonId ? `?lesson=${encodeURIComponent(c.progress.nextLessonId)}` : ''}`)}>
+            <span className="flex items-end justify-between gap-4 flex-wrap">
+              <span className="min-w-0">
+                <span className="flex items-center gap-3"><span className="t-title t-strong">{c.title}</span>{c.wip && <span className="t-meta t-mute px-2 rounded-[6px]" style={{ border: '1px solid var(--line-2)' }}>试运行</span>}</span>
+                <span className="block t-mute mt-1">{c.subtitle}</span>
+              </span>
+              <span className="t-meta t-mute lc-num">{c.lessonCount} 课 · 约 {c.minutes} 分钟 · 练习完成 {c.progress.practicesDone} 次</span>
+            </span>
+            <span className="lc-mini-metro" style={{ ['--n' as string]: c.lessonCount }}>
+              {Array.from({ length: c.lessonCount }, (_, i) => (
+                <span key={i} className="lc-mini-stop" data-done={i < c.progress.lessonsDone} data-next={i === nextIdx}><i />{c.lessonShortTitles[i] ?? `第 ${i + 1} 课`}</span>
+              ))}
+            </span>
+            <span className="flex items-center justify-end gap-1.5 t-strong" style={{ color: 'var(--hi)' }}>
+              {c.progress.lessonsDone > 0 ? '继续' : '开始'}{c.progress.nextLessonTitle ? `：${c.progress.nextLessonTitle}` : ''}<ArrowRight size={15} />
+            </span>
+          </button>
+        );
+      })}
+    </section>
+  );
+}
