@@ -0,0 +1,142 @@
+import { useEffect, useMemo, useRef, useState } from 'react';
+import { Columns2, Layers } from 'lucide-react';
+import { SEVERITY_REGISTRY } from './registry';
+import type { CodeFile, Decision, Finding, Practice } from './types';
+
+type Row = { n: number | null; text: string; diff?: 'add' | 'del'; finding?: Finding };
+
+/* 把被采纳的修复按 diff 行插回源码：'-' 行标删除，'+' 行标新增，其余原样 */
+function buildRows(file: CodeFile, findings: Finding[], decisions: Record<string, Decision>, showFixes: boolean): Row[] {
+  const byLine = new Map<number, Finding>();
+  findings.filter(f => f.location.file === file.path && f.location.line).forEach(f => byLine.set(f.location.line!, f));
+  const rows: Row[] = [];
+  file.lines.forEach((text, i) => {
+    const n = i + 1;
+    const f = byLine.get(n);
+    if (showFixes && f && decisions[f.id] === 'accept' && f.fix?.length) {
+      f.fix.forEach(d => rows.push({ n: d.startsWith('-') ? n : null, text: d.slice(1), diff: d.startsWith('-') ? 'del' : 'add', finding: f }));
+    } else rows.push({ n, text, finding: f });
+  });
+  return rows;
+}
+
+function CodeView({ practice, findings, decisions, selected, onSelect, showFixes }: WorkbenchProps & { practice: Practice & { subject: { kind: 'code' } } }) {
+  const files = practice.subject.files;
+  const [fileIdx, setFileIdx] = useState(0);
+  const file = files[Math.min(fileIdx, files.length - 1)];
+  const rows = useMemo(() => buildRows(file, findings, decisions, showFixes), [file, findings, decisions, showFixes]);
+  const box = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    const f = findings.find(x => x.id === selected);
+    if (f?.location.file && f.location.file !== file.path) { const i = files.findIndex(x => x.path === f.location.file); if (i >= 0) setFileIdx(i); }
+    const row = box.current?.querySelector<HTMLElement>(`[data-finding-row="${selected}"]`);
+    if (row && box.current) box.current.scrollTo({ top: Math.max(0, row.offsetTop - 60), behavior: 'smooth' });
+  }, [selected, findings, file.path, files]);
+
+  return (
+    <div className="flex flex-col h-full min-h-0">
+      <div className="flex items-center gap-1 px-2 pt-2 overflow-x-auto shrink-0" style={{ scrollbarWidth: 'none' }}>
+        {files.map((f, i) => (
+          <button key={f.path} type="button" className="lc-chapter lc-mono" aria-current={i === fileIdx} onClick={() => setFileIdx(i)}>{f.path}</button>
+        ))}
+      </div>
+      <div ref={box} className="lc-scroll flex-1 lc-code lc-mono py-2" data-lc="code-view" style={{ overflowX: 'auto' }}>
+        {rows.map((r, i) => {
+          const sev = r.finding ? SEVERITY_REGISTRY[r.finding.severity] : null;
+          const first = r.finding && (i === 0 || rows[i - 1].finding?.id !== r.finding.id);
+          return (
+            <div key={i} className="lc-code-row" data-flag={!!r.finding} data-selected={!!r.finding && r.finding.id === selected} data-diff={r.diff} data-finding-row={first ? r.finding!.id : undefined}>
+              <span>
+                {first && sev && (
+                  <button type="button" className="lc-gutter-flag" style={{ color: sev.color }} onClick={() => onSelect(r.finding!.id)} aria-label={`${sev.label}：${r.finding!.title}`} data-qc-touch-exempt>
+                    {findings.indexOf(r.finding!) + 1}
+                  </button>
+                )}
+              </span>
+              <span className="lc-ln">{r.n ?? ''}</span>
+              <span className="lc-src">{r.diff === 'add' ? '+ ' : r.diff === 'del' ? '- ' : '  '}{r.text}</span>
+            </div>
+          );
+        })}
+      </div>
+    </div>
+  );
+}
+
+function VisualView({ practice, findings, decisions, selected, onSelect, showFixes }: WorkbenchProps & { practice: Practice & { subject: { kind: 'visual' } } }) {
+  const s = practice.subject;
+  const [mode, setMode] = useState<'side' | 'overlay'>('side');
+  const [mix, setMix] = useState(50);
+  const regions = (
+    findings.filter(f => f.location.region).map((f, i) => {
+      const r = f.location.region!;
+      const fixed = showFixes && decisions[f.id] === 'accept';
+      return (
+        <button key={f.id} type="button" className="lc-region" data-severity={f.severity} data-selected={f.id === selected}
+          style={{ left: `${r.x}%`, top: `${r.y}%`, width: `${r.w}%`, height: `${r.h}%`, color: SEVERITY_REGISTRY[f.severity].color, opacity: fixed ? 0.35 : 1 }}
+          onClick={() => onSelect(f.id)} aria-label={f.title} data-qc-touch-exempt>
+          <span className="lc-region-tag">{i + 1}</span>
+        </button>
+      );
+    })
+  );
+  return (
+    <div className="flex flex-col h-full min-h-0 p-3 gap-3" data-lc="visual-view">
+      <div className="flex items-center gap-2 flex-wrap shrink-0">
+        <div className="lc-media-switch" role="group" aria-label="对照方式">
+          <button type="button" className="lc-media-btn" aria-pressed={mode === 'side'} onClick={() => setMode('side')}><Columns2 size={14} />并排</button>
+          <button type="button" className="lc-media-btn" aria-pressed={mode === 'overlay'} onClick={() => setMode('overlay')}><Layers size={14} />叠加</button>
+        </div>
+        <span className="text-[12px] lc-muted">{s.viewport} · {s.theme} · 同一份演示数据</span>
+      </div>
+      {mode === 'side' ? (
+        <div className="grid gap-3 flex-1 min-h-0 content-start" style={{ gridTemplateColumns: 'repeat(auto-fit, minmax(240px, 1fr))' }}>
+          <figure className="flex flex-col gap-1.5">
+            <figcaption className="text-[12px] font-semibold lc-secondary">基线（上一版）</figcaption>
+            <img src={s.baselineUrl} alt="基线截图" className="w-full rounded-[10px]" style={{ border: '1px solid var(--border-subtle)' }} />
+          </figure>
+          <figure className="flex flex-col gap-1.5">
+            <figcaption className="text-[12px] font-semibold lc-secondary">实际（本次改动）</figcaption>
+            <div className="relative">
+              <img src={s.actualUrl} alt="实际截图" className="w-full rounded-[10px] block" style={{ border: '1px solid var(--border-subtle)' }} />
+              {regions}
+            </div>
+          </figure>
+        </div>
+      ) : (
+        <div className="flex flex-col gap-2 flex-1 min-h-0">
+          <div className="relative max-w-[720px] w-full">
+            <img src={s.baselineUrl} alt="基线截图" className="w-full rounded-[10px] block" style={{ border: '1px solid var(--border-subtle)' }} />
+            <img src={s.actualUrl} alt="实际截图" className="w-full rounded-[10px] absolute inset-0" style={{ opacity: mix / 100 }} />
+            {regions}
+          </div>
+          <label className="flex items-center gap-3 text-[12px] lc-secondary max-w-[720px]">
+            基线<input type="range" min={0} max={100} value={mix} onChange={e => setMix(Number(e.target.value))} className="flex-1" style={{ minHeight: 44 }} />实际
+          </label>
+        </div>
+      )}
+    </div>
+  );
+}
+
+export interface WorkbenchProps {
+  practice: Practice;
+  findings: Finding[];
+  decisions: Record<string, Decision>;
+  selected?: string;
+  onSelect: (id: string) => void;
+  /** 复测后展示已应用的修复 */
+  showFixes: boolean;
+}
+
+export function PracticeWorkbench(props: WorkbenchProps) {
+  const { practice } = props;
+  return (
+    <div className="lc-surface h-full min-h-0 flex flex-col overflow-hidden" data-tour-id="practice-workbench">
+      {practice.subject.kind === 'code'
+        ? <CodeView {...props} practice={practice as Practice & { subject: { kind: 'code' } }} />
+        : <VisualView {...props} practice={practice as Practice & { subject: { kind: 'visual' } }} />}
+    </div>
+  );
+}
diff --git a/prd-admin/src/pages/learning-course/registry.ts b/prd-admin/src/pages/learning-course/registry.ts
new file mode 100644
--- /dev/null
+++ b/prd-admin/src/pages/learning-course/registry.ts
@@ -0,0 +1,53 @@
+import { BookOpenText, Bug, Eye, FileText, FlaskConical, Network, PlayCircle, type LucideIcon } from 'lucide-react';
+import type { FindingSeverity, LessonMediaKind, PracticeSkill } from './types';
+
+/* 课程页的类型映射统一放在这里（注册表模式），组件里不写 switch。 */
+
+export const MEDIA_REGISTRY: Record<LessonMediaKind, { label: string; icon: LucideIcon; unit: (n: number) => string }> = {
+  video: { label: '视频', icon: PlayCircle, unit: n => formatClock(n) },
+  pdf: { label: 'PDF 教材', icon: FileText, unit: n => `${n} 页` },
+  article: { label: '图文', icon: BookOpenText, unit: n => `${n} 分钟` },
+};
+
+export const MEDIA_ORDER: LessonMediaKind[] = ['video', 'pdf', 'article'];
+
+export const SKILL_REGISTRY: Record<PracticeSkill, { label: string; icon: LucideIcon; verb: string }> = {
+  review: { label: '代码评审', icon: Bug, verb: '评审' },
+  visual: { label: '视觉验收', icon: Eye, verb: '对照' },
+  unit: { label: '单元测试', icon: FlaskConical, verb: '生成测试' },
+  integration: { label: '联合测试', icon: Network, verb: '串链路' },
+};
+
+/* 严重级只用语义色 token，深浅主题各自成立 */
+export const SEVERITY_REGISTRY: Record<FindingSeverity, { label: string; color: string }> = {
+  P0: { label: 'P0 阻断', color: 'var(--accent-fg-error)' },
+  P1: { label: 'P1 严重', color: 'var(--accent-fg-warning)' },
+  P2: { label: 'P2 建议', color: 'var(--accent-fg-info)' },
+};
+
+export const PRACTICE_STEPS = [
+  { key: 'brief', label: '读任务' },
+  { key: 'review', label: 'Agent 检查' },
+  { key: 'triage', label: '判断与修复' },
+  { key: 'retest', label: '复测' },
+  { key: 'deliver', label: '交付' },
+] as const;
+
+export function formatClock(sec: number): string {
+  const s = Math.max(0, Math.round(sec));
+  return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
+}
+
+export function formatDuration(sec: number): string {
+  if (sec < 60) return `${Math.max(1, Math.round(sec))} 秒`;
+  const m = Math.round(sec / 60);
+  return m < 60 ? `${m} 分钟` : `${Math.floor(m / 60)} 小时 ${m % 60} 分钟`;
+}
+
+/* 逐条判断的说法随练习类型变化，判定口径相同：采纳 = 应用修复 / 保留；驳回必须写理由 */
+export const DECISION_REGISTRY: Record<PracticeSkill, { accept: string; reject: string; quickReasons: string[]; runLabel: string }> = {
+  review: { accept: '采纳修复', reject: '驳回', runLabel: '评审', quickReasons: ['前提不成立：函数没有共享状态', '属于风格偏好，不影响结果', '不在本次范围，已登记后续'] },
+  visual: { accept: '判为缺陷', reject: '在容差内', runLabel: '对照', quickReasons: ['偏差在 1px 容差内', '与设计稿一致', '不在本次改动范围'] },
+  unit: { accept: '保留这条测试', reject: '删掉这条', runLabel: '生成测试', quickReasons: ['依赖当前时间，结果不稳定', '与已有测试重复', '断言的是实现细节'] },
+  integration: { accept: '保留这条测试', reject: '删掉这条', runLabel: '串链路', quickReasons: ['打的是本地桩，不是真实部署', '与已有测试重复', '断言的是实现细节'] },
+};
