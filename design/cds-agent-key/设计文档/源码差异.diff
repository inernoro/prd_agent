+    if (input.projectId && row.access.scope !== 'all'
+      && !row.access.projects.some((p) => p.id === input.projectId)) continue;
+    rows.push(row);
+  }
+  return rows.sort((a, b) => (Date.parse(b.createdAt) || 0) - (Date.parse(a.createdAt) || 0));
+}
