+      )}
+      {done && m.ready && latest && (
+        <section className="qc-card qc-rise p-3.5" data-qc="ready-card">
+          <div className="flex items-center gap-2 text-[14px] font-semibold text-token-primary"><Sparkles size={15} className="text-[color:var(--accent-primary)]" aria-hidden />准备好了</div>
+          {session.brief.summary && <p className="m-0 mt-1.5 whitespace-pre-line text-[12.5px] leading-5 text-token-secondary">{session.brief.summary}</p>}
+          <div className="mt-3 flex flex-wrap items-center gap-2">
+            <Button variant="primary" className="qc-face qc-face-primary relative px-3.5" data-qc="brief-start" disabled={!active} onClick={onStart}><Play size={14} />开始生成（约 30–60 分钟）</Button>
+            <Button variant="ghost" size="sm" className="max-md:min-h-11" data-qc="brief-skip-script" disabled={!active} onClick={onSkipScript}>跳过脚本，直接开始</Button>
+          </div>
+          <p className="m-0 mt-2 text-[11.5px] text-token-muted">点「开始生成」会先花一两分钟出分镜脚本给你确认，再正式排队。</p>
+        </section>
+      )}
+      {done && !!m.script?.length && (
+        <section className="qc-card qc-rise overflow-hidden" data-qc={latest ? 'script-draft' : undefined} data-target-sec={m.scriptTargetSec} data-scenes={m.script.length}>
+          <div className="flex flex-wrap items-center gap-x-2 gap-y-1 border-b border-token-subtle px-3.5 py-2.5">
+            <span className="inline-flex items-center gap-2 text-[13.5px] font-semibold text-token-primary"><Clapperboard size={15} className="text-[color:var(--accent-primary)]" aria-hidden />分镜脚本 · {m.script.length} 幕</span>
+            {scriptTotal > 0 && (
+              <span className="text-[12.5px] tabular-nums text-token-secondary" data-qc="script-total">
+                合计约 {Math.floor(scriptTotal / 60)} 分 {String(scriptTotal % 60).padStart(2, '0')} 秒{m.scriptTargetSec ? `（目标约 ${m.scriptTargetSec < 60 ? `${m.scriptTargetSec} 秒` : `${Math.round(m.scriptTargetSec / 60)} 分钟`}）` : ''}
+              </span>
+            )}
+            {latest && (
+              <span className="ml-auto inline-flex items-center gap-1" aria-label="调整时长">
+                <button type="button" data-qc="script-shorter" disabled={!active || (m.scriptTargetSec ?? 0) <= 60} onClick={() => onAdjustScript('shorter')}
+                  className="qc-face qc-face-chip relative inline-flex items-center px-2.5 text-[12px] text-token-primary disabled:opacity-50">短一点</button>
+                <button type="button" data-qc="script-longer" disabled={!active || (m.scriptTargetSec ?? 0) >= 600} onClick={() => onAdjustScript('longer')}
+                  className="qc-face qc-face-chip relative inline-flex items-center px-2.5 text-[12px] text-token-primary disabled:opacity-50">长一点</button>
+              </span>
+            )}
+          </div>
+          <ol className="m-0 max-h-[360px] list-none overflow-y-auto p-0" style={{ overscrollBehavior: 'contain' }}>
+            {m.script.map(sc => (
+              <li key={sc.index} className="flex gap-3 border-b border-token-subtle px-3.5 py-2 text-[12.5px] last:border-b-0">
+                <span className="w-5 shrink-0 tabular-nums text-token-muted">{sc.index}</span>
+                <div className="min-w-0 flex-1">
+                  <div className="text-token-primary">{sc.visual}</div>
+                  <div className="line-clamp-2 text-token-secondary">旁白：{sc.narration}</div>
+                </div>
+                {sc.seconds != null && <span className="shrink-0 tabular-nums text-[12px] text-token-muted">{sc.seconds} 秒</span>}
+              </li>
+            ))}
+          </ol>
+          {latest && (
+            <div className="flex flex-wrap items-center gap-2 border-t border-token-subtle bg-[var(--bg-secondary)] px-3.5 py-2.5">
+              <div className="basis-full"><TrialToggle on={trialOn} estimate={estimate} onChange={onToggleTrial} /></div>
+              <Button variant="primary" className="qc-face qc-face-primary relative px-3.5" data-qc="script-confirm" disabled={!active} onClick={onConfirmScript}><Play size={14} />{trialOn ? '按这个脚本先做试看' : '按这个脚本开始生成'}</Button>
+              <span className="text-[12px] text-token-muted">想改哪一幕直接说，例如「第 3 幕换成客户案例」</span>
+            </div>
+          )}
+        </section>
+      )}
+      <div ref={endRef} aria-hidden />
+    </AgentTurn>
+  );
+}
+
+/** 对话流：你的消息靠右，助手的回复带头像与模型名；正在等回复时显示一条在动的占位 */
+export function BriefConversation({ session, pendingText, revealId, templates, busy, onReply, onUseStyle, onStart, onSkipScript, onConfirmScript, onAdjustScript, trialOn, estimate, onToggleTrial }: {
+  session: QcBriefSession | null;
+  pendingText: string | null;
+  revealId: string | null;
+  templates: QcTemplate[];
+  busy: boolean;
+  onReply: (text: string) => void;
+  onUseStyle: (templateId: string) => void;
+  onStart: () => void;
+  onSkipScript: () => void;
+  onConfirmScript: () => void;
+  onAdjustScript: (a: 'shorter' | 'longer') => void;
+  trialOn: boolean;
+  estimate?: QcEstimate | null;
+  onToggleTrial: (v: boolean) => void;
+}) {
+  const messages = session?.messages ?? [];
+  const lastAgent = [...messages].reverse().find(x => x.role === 'agent');
+  return (
+    <>
+      {messages.map(m => m.role === 'user' ? (
+        <UserTurn key={m.id}><p className="m-0 whitespace-pre-wrap px-1 text-[14px] leading-6 text-token-primary">{m.text}</p></UserTurn>
+      ) : session && (
+        <AgentMessage key={m.id} m={m} latest={m.id === lastAgent?.id && !pendingText} revealing={m.id === revealId} templates={templates} session={session} busy={busy}
+          onReply={onReply} onUseStyle={onUseStyle} onStart={onStart} onSkipScript={onSkipScript} onConfirmScript={onConfirmScript} onAdjustScript={onAdjustScript} trialOn={trialOn} estimate={estimate} onToggleTrial={onToggleTrial} />
+      ))}
+      {pendingText && (
+        <>
+          <UserTurn><p className="m-0 whitespace-pre-wrap px-1 text-[14px] leading-6 text-token-primary">{pendingText}</p></UserTurn>
+          <AgentTurn status="正在想">
+            <div className="flex items-center gap-2 text-[13px] text-token-secondary" data-qc="agent-thinking"><MapSpinner size={13} />正在理解你的需求，马上回复</div>
+          </AgentTurn>
+        </>
+      )}
+    </>
+  );
+}
diff --git a/src/added/pages/quick-creation-agent/BrowserExport.tsx b/src/added/pages/quick-creation-agent/BrowserExport.tsx
new file mode 100644
--- /dev/null
+++ b/src/added/pages/quick-creation-agent/BrowserExport.tsx
@@ -0,0 +1,108 @@
+/**
+ * 成片导出：在用户自己的浏览器里合成视频文件，服务器只存画面代码和配音。
+ * 播放本来就不需要视频文件（右边的播放器直接跑画面代码 + 配音）；只有要把视频拿去别处用时才导出。
+ * 浏览器合成不了（老 Safari、安卓 Firefox 等）才请服务器代为导出，排队执行，作为兜底。
+ */
+import { useEffect, useRef, useState } from 'react';
+import { Check, Download, Laptop, Server, X } from 'lucide-react';
+import { Button } from '@/components/design/Button';
+import { MapSpinner } from '@/components/ui/VideoLoader';
+import { requestServerExport } from '@/services/real/quickCreation';
+import { detectBrowserExport, exportFilmInBrowser, exportPlan, type ExportContainer, type ExportProgress, type ExportResult } from './browserExport';
+import { formatClock } from './format';
+import type { QcRun } from './types';
+
+type State =
+  | { s: 'idle' }
+  | { s: 'exporting'; p: ExportProgress }
+  | { s: 'done'; r: ExportResult }
+  | { s: 'failed'; msg: string }
+  | { s: 'server'; position: number; etaMin: number };
+
+const mb = (bytes: number) => `${Math.max(1, Math.round(bytes / 1_000_000))} MB`;
+
+export function BrowserExport({ run }: { run: QcRun }) {
+  const bundle = run.bundle;
+  const [container, setContainer] = useState<ExportContainer | null | undefined>(undefined);
+  const [state, setState] = useState<State>({ s: 'idle' });
+  const abort = useRef<AbortController | null>(null);
+  const phone = typeof window !== 'undefined' && window.matchMedia('(max-width: 767px)').matches;
+  useEffect(() => { if (bundle) void detectBrowserExport(bundle).then(setContainer); }, [bundle]);
+  useEffect(() => () => abort.current?.abort(), []);
+  if (!bundle || run.kind !== 'video') return null;
+  const durationSec = run.durationSec ?? 60;
+  const plan = exportPlan(bundle, durationSec, phone);
+  const fmt = container === 'webm' ? 'WebM' : 'MP4';
+
+  const start = async () => {
+    if (!container) return;
+    abort.current = new AbortController();
+    setState({ s: 'exporting', p: { frame: 0, frames: plan.frames, elapsedSec: 0, remainSec: plan.estSec } });
+    try {
+      const r = await exportFilmInBrowser({ bundle, durationSec, title: run.title, container, phone, mediaUrl: run.media?.url }, p => setState({ s: 'exporting', p }), abort.current.signal);
+      setState({ s: 'done', r });
+    } catch (e) {
+      if ((e as DOMException)?.name === 'AbortError') { setState({ s: 'idle' }); return; }
+      setState({ s: 'failed', msg: '合成到一半停下了，可能是这台设备内存不够。可以关掉其他页面后重试，或请服务器导出。' });
+    }
+  };
+  const viaServer = async () => {
+    const res = await requestServerExport(run.id);
+    if (res.success) setState({ s: 'server', position: res.data.position, etaMin: res.data.etaMin });
+    else setState({ s: 'failed', msg: `${res.error?.message || '服务器这次没有接单'}，请稍后再试` });
+  };
+
+  if (state.s === 'exporting') {
+    const pct = state.p.frames ? Math.round((state.p.frame / state.p.frames) * 100) : 0;
+    return (
+      <div className="mt-3 rounded-[10px] border border-token-subtle bg-[var(--bg-secondary)] p-3" data-qc="export-card" data-state="exporting">
+        <div className="flex items-center gap-2 text-[13px] font-medium text-token-primary"><MapSpinner size={13} />正在用你的浏览器合成 {fmt}</div>
+        <div className="mt-2 h-1.5 overflow-hidden rounded-full bg-[var(--border-default)]"><div className="qc-bar-live h-full rounded-full transition-[width] duration-200" style={{ width: `${pct}%` }} /></div>
+        <div className="mt-1.5 flex flex-wrap items-center gap-x-3 text-[12px] tabular-nums text-token-secondary">
+          <span>第 {state.p.frame.toLocaleString('en-US')} / {state.p.frames.toLocaleString('en-US')} 帧</span>
+          <span>已用 {formatClock(state.p.elapsedSec)}</span>
+          {state.p.remainSec != null && <span>还需约 {formatClock(state.p.remainSec)}</span>}
+        </div>
+        <div className="mt-1.5 flex items-center justify-between gap-2">
+          <span className="text-[12px] text-token-muted">保持这个页面在前台，切走会变慢。</span>
+          <Button size="xs" variant="ghost" data-qc="export-cancel" onClick={() => abort.current?.abort()}><X size={12} />取消</Button>
+        </div>
+      </div>
+    );
+  }
+  if (state.s === 'done') {
+    return (
+      <div className="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2 rounded-[10px] border border-token-subtle bg-[var(--bg-secondary)] p-3" data-qc="export-card" data-state="done">
+        <span className="inline-flex min-w-0 flex-1 items-center gap-2 text-[13px] text-token-primary"><Check size={15} className="shrink-0 text-[color:var(--accent-fg-success)]" aria-hidden />
+          <span className="min-w-0 truncate">已导出 {state.r.fileName} · {mb(state.r.bytes)}</span></span>
+        <a href={state.r.url} download={state.r.fileName} data-qc="export-download"
+          className="inline-flex h-8 items-center gap-1.5 rounded-[9px] border border-[var(--border-default)] px-3 text-[12px] font-medium text-token-primary hover-bg-soft max-md:h-11"><Download size={13} />下载</a>
+      </div>
+    );
+  }
+  if (state.s === 'server') {
+    return (
+      <div className="mt-3 rounded-[10px] border border-token-subtle bg-[var(--bg-secondary)] p-3 text-[12.5px] leading-5 text-token-secondary" data-qc="export-card" data-state="server">
+        已交给服务器导出：前面还有 {state.position} 个，预计 {state.etaMin} 分钟后可以下载，完成后会通知你。
+      </div>
+    );
+  }
+  return (
+    <div className="mt-4" data-qc="export-idle">
+      {container === undefined && <div className="flex h-8 items-center gap-2 text-[12px] text-token-muted"><MapSpinner size={12} />正在看这个浏览器能不能合成视频…</div>}
+      {container && (
+        <div className="flex flex-wrap items-center gap-x-3 gap-y-1.5">
+          <Button size="sm" variant="secondary" className="max-md:min-h-11" data-qc="export-start" onClick={() => void start()}><Laptop size={13} />导出 {fmt} 文件</Button>
+          <span className="text-[12px] text-token-muted">在你的浏览器里合成，约 {formatClock(plan.estSec)}，不占服务器</span>
+        </div>
+      )}
+      {container === null && (
+        <div>
+          <p className="m-0 text-[12.5px] leading-5 text-token-secondary" data-qc="export-unsupported">这个浏览器不能在本机合成视频。用电脑上的 Chrome、Edge 或 Safari 打开这一页就能导出；也可以请服务器代为导出（要排队）。</p>
+          <Button size="sm" variant="secondary" className="mt-2 max-md:min-h-11" data-qc="export-server" onClick={() => void viaServer()}><Server size={13} />请服务器导出</Button>
+        </div>
+      )}
+      {state.s === 'failed' && <p className="m-0 mt-2 text-[12px] text-token-secondary" role="alert">{state.msg}</p>}
+    </div>
+  );
+}
diff --git a/src/added/pages/quick-creation-agent/Conversation.tsx b/src/added/pages/quick-creation-agent/Conversation.tsx
new file mode 100644
--- /dev/null
+++ b/src/added/pages/quick-creation-agent/Conversation.tsx
@@ -0,0 +1,35 @@
+/**
+ * 对话的两种说话人，一眼分得清：
+ * - 你：靠右的主色浅底气泡，资料卡收在气泡里，下方一行写产出与模板；
+ * - 快速创作：靠左，带头像与名字，不套气泡；它的状态（已保存、排队、进度、失败、完成）都是这一轮里的卡片，
+ *   不再和你的消息交错成一列。
+ */
+import type { ReactNode } from 'react';
+import { Sparkles } from 'lucide-react';
+
+export function AgentTurn({ children, status }: { children: ReactNode; status?: ReactNode }) {
+  return (
+    <div className="qc-rise flex gap-2.5" data-turn="agent">
+      <span className="mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-[9px] bg-[color:var(--accent-primary)] text-[color:var(--accent-on-primary)]" aria-hidden>
+        <Sparkles size={14} />
+      </span>
+      <div className="min-w-0 flex-1">
+        <div className="flex h-7 items-center gap-2 text-[12.5px]">
+          <span className="font-medium text-token-primary">快速创作</span>
+          {status && <span className="min-w-0 truncate text-token-muted">{status}</span>}
+        </div>
+        <div className="mt-1 flex flex-col gap-3">{children}</div>
+      </div>
+    </div>
+  );
+}
+
+export function UserTurn({ children, meta }: { children: ReactNode; meta?: ReactNode }) {
+  return (
+    <div className="qc-rise ml-auto flex w-full max-w-[92%] flex-col items-end gap-1.5" data-turn="user">
+      {/* 气泡按内容收宽：一句话就一句话的宽，带资料卡时才撑开 */}
+      <div className="flex w-fit max-w-full flex-col gap-2.5 rounded-[18px_18px_4px_18px] bg-[var(--selection-bg)] px-3 py-2.5">{children}</div>
+      {meta && <div className="flex items-center gap-1.5 px-1 text-[11.5px] text-token-muted">{meta}</div>}
+    </div>
+  );
+}
diff --git a/src/added/pages/quick-creation-agent/Duration.tsx b/src/added/pages/quick-creation-agent/Duration.tsx
new file mode 100644
--- /dev/null
+++ b/src/added/pages/quick-creation-agent/Duration.tsx
@@ -0,0 +1,76 @@
+/**
+ * 成片时长：开工前就让人知道「大概多长」，也能自己定。
+ * - 自动：服务端按内容估算（稿件全文照念多长、取多少讲重点），选项上直接写出估算值，不写空泛的「自动」；
+ * - 指定：约 1 / 3 / 5 / 10 分钟。服务端按目标决定幕数与旁白字数，并校验脚本总时长落在目标的 ±15%。
+ * 估算值来自 POST /api/quick-creation/estimate，前端只显示。
+ * 选项放在「时长 · 风格」按钮的面板顶部：时长、风格都是「怎么做这一支」，收在同一个按钮里，输入框不再多一个按钮。
+ */
+import { Check } from 'lucide-react';
+import { cn } from '@/lib/cn';
+import type { DurationChoice, QcEstimate } from './types';
+
+const OPTIONS: { value: DurationChoice; label: string; hint: string }[] = [
+  { value: 'auto', label: '自动', hint: '按内容估算' },
+  { value: 60, label: '约 1 分钟', hint: '讲重点' },
+  { value: 180, label: '约 3 分钟', hint: '讲清楚' },
+  { value: 300, label: '约 5 分钟', hint: '一步步教' },
+  { value: 600, label: '约 10 分钟', hint: '完整课程' },
+];
+
+export const minutesLabel = (sec: number) => (sec < 60 ? `${sec} 秒` : `${Math.round(sec / 60)} 分钟`);
+/** 按钮上的短写：自动时直接写估算值 */
+export function durationShort(value: DurationChoice, estimate?: QcEstimate | null) {
+  const sec = value === 'auto' ? estimate?.autoSec : value;
+  return sec ? `约 ${minutesLabel(sec)}` : '时长';
+}
+
+/** 时长选项：桌面在时长按钮的面板里，手机在「视频 · 风格」面板顶部 */
+export function DurationOptions({ value, estimate, onChange, compact }: { value: DurationChoice; estimate?: QcEstimate | null; onChange: (v: DurationChoice) => void; compact?: boolean }) {
+  return (
+    <div>
+      <div role="radiogroup" aria-label="成片时长" className={cn(compact ? 'flex gap-1.5 overflow-x-auto pb-0.5' : 'flex flex-col gap-0.5')} style={compact ? { scrollbarWidth: 'none' } : undefined}>
+        {OPTIONS.map(o => {
+          const on = o.value === value;
+          const label = o.value === 'auto' && estimate ? `自动 · 约 ${minutesLabel(estimate.autoSec)}` : o.label;
+          return compact ? (
+            <button key={String(o.value)} type="button" role="radio" aria-checked={on} data-qc="duration-option" data-value={String(o.value)} onClick={() => onChange(o.value)}
+              className={cn('qc-face qc-face-chip relative inline-flex shrink-0 items-center px-3 text-[12.5px]', on ? 'font-medium text-[color:var(--accent-primary)]' : 'text-token-primary')}>
+              {label}
+            </button>
+          ) : (
+            <button key={String(o.value)} type="button" role="radio" aria-checked={on} data-qc="duration-option" data-value={String(o.value)} onClick={() => onChange(o.value)}
+              className={cn('flex min-h-9 items-center gap-2 rounded-lg px-2.5 text-left text-[13px] hover-bg-soft', on && 'bg-[var(--selection-bg)]')}>
+              <span className="min-w-0 flex-1 text-token-primary">{label}</span>
+              <span className="shrink-0 text-[12px] text-token-muted">{o.hint}</span>
+              <Check size={14} className={cn('shrink-0 text-[color:var(--accent-primary)]', !on && 'invisible')} aria-hidden />
+            </button>
+          );
+        })}
+      </div>
+      {estimate && (
+        <p className="m-0 mt-2 text-[12px] leading-[18px] text-token-secondary" data-qc="duration-basis">
+          {estimate.basis}。分成约 {estimate.scenes} 幕，生成约 {estimate.generateMin[0]}–{estimate.generateMin[1]} 分钟。
+        </p>
+      )}
+    </div>
+  );
+}
+
+/**
+ * 先试看：只做片头和第 1 幕（带配音），满意再做完。3 分钟及以上默认开：越长，方向不对时白做得越多。
+ * 用户手动改过就以用户为准，不再随时长自动变。
+ */
+export function TrialToggle({ on, estimate, onChange }: { on: boolean; estimate?: QcEstimate | null; onChange: (v: boolean) => void }) {
+  return (
+    <button type="button" role="switch" aria-checked={on} data-qc="trial-toggle" onClick={() => onChange(!on)}
+      className="flex min-h-11 w-full items-center gap-2.5 rounded-lg px-1 text-left hover-bg-soft md:min-h-9">
+      <span aria-hidden className={cn('relative inline-flex h-[18px] w-8 shrink-0 rounded-full transition-colors', on ? 'bg-[var(--accent-primary)]' : 'bg-[var(--border-default)]')}>
+        <span className={cn('absolute top-[2px] h-[14px] w-[14px] rounded-full bg-[var(--bg-input)] shadow-sm transition-[left]', on ? 'left-[16px]' : 'left-[2px]')} />
+      </span>
+      <span className="min-w-0 flex-1">
+        <span className="block text-[12.5px] text-token-primary">先试看片头和第 1 幕，满意再做完</span>
+        <span className="block text-[11.5px] text-token-muted">{estimate ? `约 ${estimate.trialMin[0]}–${estimate.trialMin[1]} 分钟出试看；` : ''}方向不对时只白做一成</span>
+      </span>
+    </button>
+  );
+}
diff --git a/src/added/pages/quick-creation-agent/Landing.tsx b/src/added/pages/quick-creation-agent/Landing.tsx
new file mode 100644
--- /dev/null
+++ b/src/added/pages/quick-creation-agent/Landing.tsx
@@ -0,0 +1,190 @@
+/**
+ * 新建页（还没开始对话、也没有任务时）：居中一列，输入框是主角。
+ * - 输入框下面：几个起头（放稿件或直接开聊），安静的文字按钮；
+ * - 风格灵感：一排大海报，点一下就换成这个风格；「全部 99 种」打开风格库浮层；
+ * - 最近作品：历史就在这里，不用去右上角找。「我的」列出全部任务（含进行中、失败），「团队」列出同事的成品。
+ * 不套卡片：海报自己就是视觉重点，文字直接排在下面，靠留白分组。
+ */
+import { useEffect, useState } from 'react';
+import * as Dialog from '@radix-ui/react-dialog';
+import { ArrowRight, ExternalLink, FolderOpen, Globe, Palette, Video, X } from 'lucide-react';
