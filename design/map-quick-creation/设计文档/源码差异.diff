index 00000000..47942c32
--- /dev/null
+++ b/prd-admin/src/pages/quick-creation-agent/quickCreation.css
@@ -0,0 +1,82 @@
+/* 快速创作页的少量局部样式；颜色只取 tokens.css 语义变量 */
+/* 放进 components 层：Tailwind 工具类（hidden、sm:inline-flex 等）可以覆盖这里 */
+@layer components {
+.qc-icon-btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 32px;
+  height: 32px;
+  flex: none;
+  border: 0;
+  border-radius: 9px;
+  background: transparent;
+  color: var(--text-secondary);
+  cursor: pointer;
+  transition: background-color .15s, color .15s;
+}
+.qc-icon-btn:hover { background: var(--bg-tertiary); color: var(--text-primary); }
+.qc-icon-btn:focus-visible { outline: 2px solid var(--border-focus); outline-offset: 1px; }
+.qc-icon-btn:disabled { opacity: .4; cursor: not-allowed; }
+
+/* 卡片：左栏对话里的过程卡、右栏的面板。浅色主题带一层很轻的投影，深色主题靠边框 */
+.qc-card {
+  border: 1px solid var(--border-subtle);
+  border-radius: 14px;
+  background: var(--bg-input);
+  box-shadow: var(--shadow-site-card);
+}
+
+.qc-range { appearance: none; background: transparent; cursor: pointer; margin: 0; }
+.qc-range::-webkit-slider-runnable-track { height: 4px; border-radius: 2px; background: var(--border-default); }
+.qc-range::-webkit-slider-thumb { appearance: none; width: 12px; height: 12px; margin-top: -4px; border-radius: 50%; background: var(--accent-primary); }
+.qc-range::-moz-range-track { height: 4px; border-radius: 2px; background: var(--border-default); }
+.qc-range::-moz-range-thumb { width: 12px; height: 12px; border: 0; border-radius: 50%; background: var(--accent-primary); }
+
+@keyframes qc-pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: .45; transform: scale(.7); } }
+.qc-pulse { animation: qc-pulse 1.4s ease-in-out infinite; }
+@keyframes qc-rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
+.qc-rise { animation: qc-rise .32s ease-out both; }
+
+/* 生成中的扫光：正在画 / 正在写的那一块有一道光扫过，表示「此刻在这里干活」 */
+@keyframes qc-sweep { from { transform: translateX(-100%); } to { transform: translateX(100%); } }
+.qc-shimmer { position: relative; overflow: hidden; }
+.qc-shimmer::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  background: linear-gradient(100deg, transparent 20%, color-mix(in srgb, var(--accent-primary) 16%, transparent) 50%, transparent 80%);
+  animation: qc-sweep 1.8s ease-in-out infinite;
+  pointer-events: none;
+}
+
+/* 进行中阶段的进度条：主色 + 缓慢流动的斜纹 */
+@keyframes qc-stripes { from { background-position: 0 0; } to { background-position: 24px 0; } }
+.qc-bar-live {
+  background-color: var(--accent-primary);
+  background-image: linear-gradient(135deg, color-mix(in srgb, var(--accent-on-primary) 22%, transparent) 25%, transparent 25%, transparent 50%, color-mix(in srgb, var(--accent-on-primary) 22%, transparent) 50%, color-mix(in srgb, var(--accent-on-primary) 22%, transparent) 75%, transparent 75%);
+  background-size: 24px 24px;
+  animation: qc-stripes 1s linear infinite;
+}
+
+/* 配音中的声波：几根竖条高低起伏 */
+@keyframes qc-wave { 0%, 100% { transform: scaleY(.3); } 50% { transform: scaleY(1); } }
+.qc-wave { display: inline-flex; align-items: center; gap: 2px; height: 14px; }
+.qc-wave > i { display: block; width: 2.5px; height: 100%; border-radius: 2px; background: currentColor; transform-origin: center; animation: qc-wave 1s ease-in-out infinite; }
+.qc-wave > i:nth-child(2) { animation-delay: -.8s; }
+.qc-wave > i:nth-child(3) { animation-delay: -.6s; }
+.qc-wave > i:nth-child(4) { animation-delay: -.4s; }
+.qc-wave > i:nth-child(5) { animation-delay: -.2s; }
+
+/* 骨架：作品形状的占位在呼吸 */
+@keyframes qc-breathe { 0%, 100% { opacity: .55; } 50% { opacity: 1; } }
+.qc-skel { background: var(--skeleton-base); border-radius: 6px; animation: qc-breathe 1.6s ease-in-out infinite; }
+
+@media (prefers-reduced-motion: reduce) {
+  .qc-pulse, .qc-rise, .qc-shimmer::after, .qc-bar-live, .qc-wave > i, .qc-skel { animation: none; }
+}
+
+@media (max-width: 767px) {
+  .qc-icon-btn { width: 44px; height: 44px; }
+}
+}
diff --git a/prd-admin/src/pages/quick-creation-agent/types.ts b/prd-admin/src/pages/quick-creation-agent/types.ts
new file mode 100644
index 00000000..0290c3ae
--- /dev/null
+++ b/prd-admin/src/pages/quick-creation-agent/types.ts
@@ -0,0 +1,224 @@
+/** 快速创作：一份文档 + 一个模板 → 能播放（视频）或能浏览（网页）、能发布到网页托管的成品。 */
+
+export type OutputKind = 'video' | 'web';
+
+export type AttachmentKind = 'doc' | 'kb' | 'image';
+export type AttachmentStatus = 'reading' | 'ready' | 'failed';
+
+export interface QcAttachment {
+  id: string;
+  kind: AttachmentKind;
+  name: string;
+  /** 例如 Markdown · 6.2 KB；知识库文档写所在空间 */
+  meta: string;
+  status: AttachmentStatus;
+  /** 读出的字数（图片没有） */
+  chars?: number;
+  /** 读取中进度 0-100 */
+  progress?: number;
+  /** 失败原因：先说结果和下一步 */
+  error?: string;
+  /** 图片的用途说明 */
+  note?: string;
+  /** 回看用的正文摘录（稿件、知识库） */
+  excerpt?: string;
+}
+
+/**
+ * 模板 = 风格库里的一种风格（分类与风格取自 Lemo-Opuscar 风格库：15 类 99 种）。
+ * 同一个风格既能出视频也能出网页：视频按风格说明逐帧画出成片，网页按它的配色、字体与版式出页面。
+ */
+export interface QcTemplate {
+  /** 风格编号，等于风格库的文件夹名（例如 sketchnote） */
+  id: string;
+  /** 中文名 */
+  name: string;
+  nameEn: string;
+  /** 分类编号 01–15 */
+  categoryId: string;
+  /** 样片海报（缩略图地址） */
+  posterUrl: string;
+  /** 样片标题与一句话，用来让人预判这个风格长什么样 */
+  film: string;
+  line: string;
+  durationSec: number;
+  /** 生成时交给智能体的风格说明位置（风格库 styles/<id>/STYLE.md）；界面只显示来源，不显示原文 */
+  promptRef: string;
+  /** 需要用户自备生图工具的风格（人物要另外画），选中时提示 */
+  needsImageTool?: boolean;
+  /** 原型里用模板代码渲染分镜与成片的渲染器；没有时显示样片海报 */
+  frame?: FrameKey;
+}
+
+export interface QcTemplateCategory {
+  id: string;
+  name: string;
+  nameEn: string;
+}
+
+/** 风格库来源与授权，显示在风格详情底部 */
+export interface QcTemplateSource {
+  name: string;
+  url: string;
+  posterLicense: string;
+}
+
+export type FrameKey = 'visual-note' | 'whiteboard' | 'dark-notes' | 'guide-page' | 'card-digest';
+
+export type StageStatus = 'done' | 'running' | 'pending' | 'failed';
+
+export interface QcStage {
+  key: string;
+  label: string;
+  status: StageStatus;
+  /** 这一阶段在做什么，或做完后的结果 */
+  detail?: string;
+  /** 0-100，正在进行的阶段才有 */
+  progress?: number;
+}
+
+/** 排队看板上的一条：谁的哪份稿件，正在生成的写已运行与预计还需，排队的写预计多久后开始 */
+export interface QcQueueEntry {
+  ownerName: string;
+  title: string;
+  kind: OutputKind;
+  elapsedSec?: number;
+  remainSec?: number;
+  startInSec?: number;
+}
+
+export interface QcQueueInfo {
+  position: number;
+  ahead: number;
+  running: number;
+  capacity: number;
+  /** 预计多少秒后开始 */
+  startInSec: number;
+  /** 正在生成的任务（团队同时生成上限内） */
+  runningItems?: QcQueueEntry[];
+  /** 排在你前面的任务，按先后 */
+  aheadItems?: QcQueueEntry[];
+}
+
+export interface QcScene {
+  index: number;
+  title: string;
+  /** 模板画面编号 */
+  frameScene: number;
+  startSec: number;
+  caption: string;
+  /** waiting 尚未开始；drawing 正在画；drawn 画好待配音；voicing 配音中；ready 已完成 */
+  status: 'ready' | 'drawing' | 'drawn' | 'voicing' | 'failed' | 'waiting';
+}
+
+export interface QcKeyPoint {
+  text: string;
+  /** 视频：跳转秒数；网页：页面锚点 */
+  atSec?: number;
+  anchor?: string;
+}
+
+export interface QcWebSection {
+  anchor: string;
+  title: string;
+  body: string;
+}
+
+export interface QcFailure {
+  stageKey: string;
+  /** 视频：第几幕；网页：第几节 */
+  unitIndex?: number;
+  /** 一句话说明，先说结果 */
+  message: string;
+  /** 已经保存下来的东西 */
+  saved: string[];
+  /** 可用的恢复动作 */
+  actions: Array<'retry-unit' | 'retry-step' | 'skip-unit' | 'requeue'>;
+}
+
+export type PublishStatus = 'none' | 'publishing' | 'failed' | 'done';
+
+export interface QcPublish {
+  status: PublishStatus;
+  siteTitle?: string;
+  /** 网页托管里的站点编号，用于定位 */
+  siteId?: string;
+  error?: string;
+  at?: string;
+}
+
+export type RunStatus = 'queued' | 'running' | 'failed' | 'done';
+
+export interface QcRun {
+  id: string;
+  title: string;
+  kind: OutputKind;
+  templateId: string;
+  ask: string;
+  attachments: QcAttachment[];
+  status: RunStatus;
+  queue?: QcQueueInfo;
+  stages: QcStage[];
+  elapsedSec: number;
+  /** 预计还需多少秒；给不出时为空 */
+  remainSec?: number;
+  /** 预计依据，例如「最近 20 次的中位数」 */
+  estimateBasis?: string;
+  failure?: QcFailure;
+  scenes?: QcScene[];
+  sections?: QcWebSection[];
+  durationSec?: number;
+  keyPoints?: QcKeyPoint[];
+  voice?: string;
+  /** 成片媒体（视频产出完成后才有）：播放器直接播放它，字幕与重点随 currentTime 切换 */
+  media?: { url: string; mime: string };
+  publish: QcPublish;
+  createdAt: string;
+  updatedAt: string;
+}
+
+export interface QcWork {
+  runId: string;
+  title: string;
+  kind: OutputKind;
+  templateId: string;
+  status: RunStatus;
+  publishStatus: PublishStatus;
+  /** 第二行：状态补充，例如「第 4 幕配音超时」 */
+  summary: string;
+  updatedAt: string;
+}
+
+/**
+ * 产物：已经生成的视频或网页，用来在创作时回看——自己做过的、团队做过的，同一个风格做出来是什么样。
+ * 只列已生成的成品；进行中、失败的任务在「我的作品」里管理。
+ */
+export interface QcAsset {
+  id: string;
+  /** 打开这个产物对应的任务 */
+  runId: string;
+  title: string;
+  kind: OutputKind;
+  templateId: string;
+  /** 视频时长（秒） */
+  durationSec?: number;
+  /** 网页节数 */
+  sections?: number;
+  /** 谁做的；自己的写「我」 */
+  ownerName: string;
+  mine: boolean;
+  publishStatus: PublishStatus;
+  /** 已发布时的网页托管站点编号，用于定位 */
+  siteId?: string;
+  updatedAt: string;
+}
+
+export type AssetScope = 'mine' | 'team';
+
+export interface CreateRunInput {
+  kind: OutputKind;
+  templateId: string;
+  ask: string;
+  attachmentIds: string[];
+  title?: string;
+}
