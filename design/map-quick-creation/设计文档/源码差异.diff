index 00000000..8232e08e
--- /dev/null
+++ b/prd-admin/src/pages/quick-creation-agent/format.ts
@@ -0,0 +1,46 @@
+import type { AttachmentKind, QcAttachment } from './types';
+
+export function formatClock(sec: number): string {
+  const s = Math.max(0, Math.round(sec));
+  return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
+}
+
+/** 预计时间：不足一分钟写秒，否则写「约 N 分 M 秒」 */
+export function formatRemain(sec: number): string {
+  const s = Math.max(0, Math.round(sec));
+  if (s < 60) return `约 ${s} 秒`;
+  const m = Math.floor(s / 60), r = s % 60;
+  return r ? `约 ${m} 分 ${r} 秒` : `约 ${m} 分钟`;
+}
+
+/** 时长：「14 分 16 秒」，不足一分钟写秒；避免和时刻（14:16）混淆 */
+export function formatDuration(sec: number): string {
+  const s = Math.max(0, Math.round(sec));
+  const m = Math.floor(s / 60), r = s % 60;
+  return m ? `${m} 分${r ? ` ${r} 秒` : '钟'}` : `${r} 秒`;
+}
+
+export function formatChars(n: number): string {
+  return n.toLocaleString('zh-CN');
+}
+
+export const KIND_LABEL: Record<AttachmentKind, string> = { doc: '稿件', kb: '知识库文档', image: '图片' };
+
+/** 附件排序：失败在前，读取中其次，同状态按类型（稿件 → 知识库 → 图片） */
+export function sortAttachments(items: QcAttachment[]): QcAttachment[] {
+  const s = { failed: 0, reading: 1, ready: 2 } as const;
+  const k = { doc: 0, kb: 1, image: 2 } as const;
+  return [...items].sort((a, b) => s[a.status] - s[b.status] || k[a.kind] - k[b.kind]);
+}
+
+export function summarizeAttachments(items: QcAttachment[]) {
+  const failed = items.filter(a => a.status === 'failed').length;
+  const reading = items.filter(a => a.status === 'reading').length;
+  const chars = items.reduce((n, a) => n + (a.status === 'ready' ? a.chars ?? 0 : 0), 0);
+  const images = items.filter(a => a.kind === 'image').length;
+  return { total: items.length, failed, reading, chars, images };
+}
+
+/** 一次创作的附件上限与文字预算 */
+export const MAX_ATTACHMENTS = 10;
+export const CHAR_BUDGET = 20000;
diff --git a/prd-admin/src/pages/quick-creation-agent/quickCreation.css b/prd-admin/src/pages/quick-creation-agent/quickCreation.css
new file mode 100644
index 00000000..0d50cfdc
--- /dev/null
+++ b/prd-admin/src/pages/quick-creation-agent/quickCreation.css
@@ -0,0 +1,185 @@
+/* 快速创作页的少量局部样式；颜色只取 tokens.css 语义变量 */
+/* 放进 components 层：Tailwind 工具类（hidden、sm:inline-flex 等）可以覆盖这里 */
+@layer components {
+.qc-icon-btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 32px;
+  height: 32px;
+  flex: none;
+  border: 0;
+  border-radius: 9px;
+  background: transparent;
+  color: var(--text-secondary);
+  cursor: pointer;
+  transition: background-color .15s, color .15s;
+}
+.qc-icon-btn:hover { background: var(--bg-tertiary); color: var(--text-primary); }
+.qc-icon-btn:focus-visible { outline: 2px solid var(--border-focus); outline-offset: 1px; }
+.qc-icon-btn:disabled { opacity: .4; cursor: not-allowed; }
+
+/* 卡片：左栏对话里的过程卡、右栏的面板。浅色主题带一层很轻的投影，深色主题靠边框 */
+.qc-card {
+  border: 1px solid var(--border-subtle);
+  border-radius: 14px;
+  background: var(--bg-input);
+  box-shadow: var(--shadow-site-card);
+}
+
+.qc-range { appearance: none; background: transparent; cursor: pointer; margin: 0; }
+.qc-range::-webkit-slider-runnable-track { height: 4px; border-radius: 2px; background: var(--border-default); }
+.qc-range::-webkit-slider-thumb { appearance: none; width: 12px; height: 12px; margin-top: -4px; border-radius: 50%; background: var(--accent-primary); }
+.qc-range::-moz-range-track { height: 4px; border-radius: 2px; background: var(--border-default); }
+.qc-range::-moz-range-thumb { width: 12px; height: 12px; border: 0; border-radius: 50%; background: var(--accent-primary); }
+
+@keyframes qc-pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: .45; transform: scale(.7); } }
+.qc-pulse { animation: qc-pulse 1.4s ease-in-out infinite; }
+@keyframes qc-rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
+.qc-rise { animation: qc-rise .32s ease-out both; }
+
+/* 生成中的扫光：正在画 / 正在写的那一块有一道光扫过，表示「此刻在这里干活」 */
+@keyframes qc-sweep { from { transform: translateX(-100%); } to { transform: translateX(100%); } }
+.qc-shimmer { position: relative; overflow: hidden; }
+.qc-shimmer::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  background: linear-gradient(100deg, transparent 20%, color-mix(in srgb, var(--accent-primary) 16%, transparent) 50%, transparent 80%);
+  animation: qc-sweep 1.8s ease-in-out infinite;
+  pointer-events: none;
+}
+
+/* 进行中阶段的进度条：主色 + 缓慢流动的斜纹 */
+@keyframes qc-stripes { from { background-position: 0 0; } to { background-position: 24px 0; } }
+.qc-bar-live {
+  background-color: var(--accent-primary);
+  background-image: linear-gradient(135deg, color-mix(in srgb, var(--accent-on-primary) 22%, transparent) 25%, transparent 25%, transparent 50%, color-mix(in srgb, var(--accent-on-primary) 22%, transparent) 50%, color-mix(in srgb, var(--accent-on-primary) 22%, transparent) 75%, transparent 75%);
+  background-size: 24px 24px;
+  animation: qc-stripes 1s linear infinite;
+}
+
+/* 配音中的声波：几根竖条高低起伏 */
+@keyframes qc-wave { 0%, 100% { transform: scaleY(.3); } 50% { transform: scaleY(1); } }
+.qc-wave { display: inline-flex; align-items: center; gap: 2px; height: 14px; }
+.qc-wave > i { display: block; width: 2.5px; height: 100%; border-radius: 2px; background: currentColor; transform-origin: center; animation: qc-wave 1s ease-in-out infinite; }
+.qc-wave > i:nth-child(2) { animation-delay: -.8s; }
+.qc-wave > i:nth-child(3) { animation-delay: -.6s; }
+.qc-wave > i:nth-child(4) { animation-delay: -.4s; }
+.qc-wave > i:nth-child(5) { animation-delay: -.2s; }
+
+/* 骨架：作品形状的占位在呼吸 */
+@keyframes qc-breathe { 0%, 100% { opacity: .55; } 50% { opacity: 1; } }
+.qc-skel { background: var(--skeleton-base); border-radius: 6px; animation: qc-breathe 1.6s ease-in-out infinite; }
+
+@media (prefers-reduced-motion: reduce) {
+  .qc-pulse, .qc-rise, .qc-shimmer::after, .qc-bar-live, .qc-wave > i, .qc-skel { animation: none; }
+}
+
+@media (max-width: 767px) {
+  .qc-icon-btn { width: 44px; height: 44px; }
+}
+}
+
+/* ---------- 质感：点按区域和画出来的大小分开 ----------
+ * 手机上 44px 是手指的点按区域，不是按钮该画多大。直接把按钮画成 44px 高、13px 字，
+ * 字只占三成高度，看起来肥、像塑料。这里按钮元素仍是 44px（真实点按区域），
+ * 只在中间画一块 32px 的面；桌面上元素本身就是那块面。
+ * 放在 @layer 之外：需要压过 Button 组件自带的底色与 50% 透明的禁用态。 */
+.qc-face {
+  /* 定位交给工具类（relative / absolute），这里写了会压过 absolute */
+  isolation: isolate;
+  height: var(--qc-face-h, 32px);
+  border-radius: var(--qc-face-r, 999px);
+  background: var(--qc-face-bg, transparent);
+  box-shadow: var(--qc-face-ring, none);
+  border: 0;
+}
+.qc-face-chip { --qc-face-h: 30px; --qc-face-bg: var(--bg-input); --qc-face-ring: inset 0 0 0 1px var(--border-default); }
+.qc-face-chip:hover:not(:disabled) { --qc-face-bg: var(--bg-tertiary); }
+.qc-face-send { --qc-face-h: 32px; --qc-face-r: 999px; width: 32px; --qc-face-bg: var(--button-primary-bg); color: var(--button-primary-fg); }
+.qc-face-send:disabled { --qc-face-bg: var(--bg-tertiary); color: var(--text-muted); cursor: not-allowed; }
+.map-btn.qc-face-primary { --qc-face-h: 32px; --qc-face-r: 10px; --qc-face-bg: var(--button-primary-bg); color: var(--button-primary-fg); background: var(--qc-face-bg); box-shadow: none; }
+.map-btn.qc-face-primary:hover:not(:disabled) { --qc-face-bg: var(--button-primary-bg-hover); }
+/* 禁用不用半透明：主色打五折会变成一块发灰的塑料色，改成实心的中性底 */
+.map-btn.qc-face-primary:disabled { --qc-face-bg: var(--bg-tertiary); color: var(--text-muted); opacity: 1; }
+.map-btn.qc-face-secondary { --qc-face-h: 32px; --qc-face-r: 10px; --qc-face-bg: var(--bg-input); --qc-face-ring: inset 0 0 0 1px var(--border-default); background: var(--qc-face-bg); box-shadow: var(--qc-face-ring); }
+.map-btn.qc-face-secondary:hover:not(:disabled) { --qc-face-bg: var(--bg-tertiary); }
+.map-btn.qc-face-secondary:disabled { color: var(--text-muted); opacity: 1; }
+@media (max-width: 767px) {
+  .qc-face { height: auto; min-height: 44px; background: transparent; box-shadow: none; }
+  .map-btn.qc-face-primary, .map-btn.qc-face-secondary { background: transparent; box-shadow: none; }
+  .qc-face::before {
+    content: '';
+    position: absolute;
+    left: 0;
+    right: 0;
+    top: 50%;
+    height: var(--qc-face-h, 32px);
+    transform: translateY(-50%);
+    border-radius: var(--qc-face-r, 999px);
+    background: var(--qc-face-bg, transparent);
+    box-shadow: var(--qc-face-ring, none);
+    transition: background-color .15s;
+    z-index: -1;
+  }
+  .qc-face-send { width: 44px; }
+  .qc-face-send::before { left: 6px; right: 6px; }
+}
+
+/* 弹出菜单的底：浅色主题 --bg-input 是实色（白），深色主题它是半透明，叠在 --bg-elevated 上才不透出下面的字 */
+.qc-menu-surface { background: linear-gradient(var(--bg-input), var(--bg-input)), var(--bg-elevated); }
+.qc-face-chip[aria-checked="true"] { --qc-face-ring: inset 0 0 0 1.5px var(--accent-primary); }
+
+/* V10：安静的文字按钮（起头、次要动作）：平时没有底和框，悬停才出一层浅底 */
+.qc-face-quiet { --qc-face-h: 32px; --qc-face-bg: transparent; }
+.qc-face-quiet:hover:not(:disabled) { --qc-face-bg: var(--bg-tertiary); color: var(--text-primary); }
+/* 不依赖 Button 组件的主按钮（浮层里用） */
+.qc-face-primary-plain { --qc-face-h: 34px; --qc-face-r: 10px; --qc-face-bg: var(--button-primary-bg); color: var(--button-primary-fg); }
+.qc-face-primary-plain:hover:not(:disabled) { --qc-face-bg: var(--button-primary-bg-hover); }
+
+/* V10 输入框：一块面，不套框；靠一圈极淡的轮廓和柔和的投影浮起来，聚焦时轮廓变成主色 */
+.qc-composer {
+  background: var(--bg-input);
+  border-radius: 22px;
+  box-shadow: 0 0 0 1px var(--border-subtle), 0 16px 40px -24px var(--border-default);
+  transition: box-shadow .2s;
+}
+.qc-composer:focus-within { box-shadow: 0 0 0 1.5px var(--accent-primary), 0 16px 40px -24px var(--border-default); }
+
+/* ---------- V11 深邃底 ----------
+ * 页面与它的弹出层、浮层沿用网页托管的配色（--hosting-*，深浅两档都定义好了）：
+ * 深色是近黑的冷灰底 + 一层实色面，不再用通用的暖灰半透明玻璃（看起来像塑料）。
+ * 与 HostedCollectionManager 同一个做法：在作用域里把通用令牌指向托管令牌，组件照常写语义令牌。 */
+.qc-scope, .qc-menu-surface {
+  --text-primary: var(--hosting-text);
+  --text-secondary: var(--hosting-secondary);
+  --text-muted: var(--hosting-muted);
+  --bg-base: var(--hosting-bg);
+  --bg-elevated: var(--hosting-surface);
+  --bg-card: var(--hosting-surface);
+  --bg-card-hover: var(--hosting-inset);
+  --bg-input: var(--hosting-inset);
+  --bg-secondary: var(--hosting-surface);
+  --bg-tertiary: var(--hosting-inset);
+  --border-subtle: var(--hosting-border);
+  --border-default: var(--hosting-border-strong);
+  --accent-primary: var(--hosting-accent);
+  --accent-on-primary: var(--hosting-on-accent);
+  --selection-bg: var(--hosting-accent-soft);
+  --button-primary-bg: var(--hosting-accent);
+  --button-primary-bg-hover: color-mix(in srgb, var(--hosting-accent) 86%, var(--hosting-text));
+  --button-primary-fg: var(--hosting-on-accent);
+  --shadow-card-sm: 0 1px 2px var(--hosting-scrim);
+  color: var(--text-primary);
+}
+.qc-scope { background: var(--hosting-bg); }
+/* 输入框用实色面（比底亮一档），在深底上浮起来 */
+.qc-scope .qc-composer, .qc-composer { background: var(--hosting-surface); box-shadow: 0 0 0 1px var(--hosting-border), 0 24px 48px -28px var(--hosting-scrim); }
+.qc-scope .qc-composer:focus-within, .qc-composer:focus-within { box-shadow: 0 0 0 1.5px var(--hosting-accent), 0 24px 48px -28px var(--hosting-scrim); }
+
+/* ---------- V11 字重 ----------
+ * 600 只给页面标题、状态标题与分区标题；500 给卡片标题、名字与按钮；正文与说明 400。
+ * 中文在 600 下发闷，按钮一律 500；安静的文字按钮 400。 */
+.qc-face, .qc-scope .map-btn { font-weight: 500; }
+.qc-face-quiet { font-weight: 400; }
