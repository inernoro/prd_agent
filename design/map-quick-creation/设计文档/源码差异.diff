+/* 快速创作页的少量局部样式；颜色只取 tokens.css 语义变量 */
+/* 放进 components 层：Tailwind 工具类（hidden、sm:inline-flex 等）可以覆盖这里 */
+@layer components {
+.qc-icon-btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 32px;
+  height: 32px;
+  flex: none;
+  border: 0;
+  border-radius: var(--radius-control);
+  background: transparent;
+  color: var(--text-muted);
+  cursor: pointer;
+}
+.qc-icon-btn:hover { background: var(--bg-card-hover); color: var(--text-primary); }
+.qc-icon-btn:focus-visible { outline: 2px solid var(--border-focus); outline-offset: 1px; }
+
+.qc-range { appearance: none; background: transparent; cursor: pointer; margin: 0; }
+.qc-range::-webkit-slider-runnable-track { height: 4px; border-radius: 2px; background: var(--border-default); }
+.qc-range::-webkit-slider-thumb { appearance: none; width: 12px; height: 12px; margin-top: -4px; border-radius: 50%; background: var(--accent-primary); }
+.qc-range::-moz-range-track { height: 4px; border-radius: 2px; background: var(--border-default); }
+.qc-range::-moz-range-thumb { width: 12px; height: 12px; border: 0; border-radius: 50%; background: var(--accent-primary); }
+
+@keyframes qc-pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: .45; transform: scale(.7); } }
+.qc-pulse { animation: qc-pulse 1.4s ease-in-out infinite; }
+@keyframes qc-rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
+.qc-rise { animation: qc-rise .32s ease-out both; }
+@media (prefers-reduced-motion: reduce) { .qc-pulse, .qc-rise { animation: none; } }
+
+@media (max-width: 767px) {
+  .qc-icon-btn { width: 44px; height: 44px; }
+}
+}
diff --git a/prd-admin/src/pages/quick-creation-agent/types.ts b/prd-admin/src/pages/quick-creation-agent/types.ts
new file mode 100644
index 00000000..0cdf13f7
--- /dev/null
+++ b/prd-admin/src/pages/quick-creation-agent/types.ts
@@ -0,0 +1,157 @@
+/** 快速创作：一份文档 + 一个模板 → 能播放（视频）或能浏览（网页）、能发布到网页托管的成品。 */
+
+export type OutputKind = 'video' | 'web';
+
+export type AttachmentKind = 'doc' | 'kb' | 'image';
+export type AttachmentStatus = 'reading' | 'ready' | 'failed';
+
+export interface QcAttachment {
+  id: string;
+  kind: AttachmentKind;
+  name: string;
+  /** 例如 Markdown · 6.2 KB；知识库文档写所在空间 */
+  meta: string;
+  status: AttachmentStatus;
+  /** 读出的字数（图片没有） */
+  chars?: number;
+  /** 读取中进度 0-100 */
+  progress?: number;
+  /** 失败原因：先说结果和下一步 */
+  error?: string;
+  /** 图片的用途说明 */
+  note?: string;
+  /** 回看用的正文摘录（稿件、知识库） */
+  excerpt?: string;
+}
+
+export interface QcTemplate {
+  id: string;
+  kind: OutputKind;
+  name: string;
+  /** 一句话风格 */
+  tagline: string;
+  /** 适合讲什么 */
+  goodFor: string;
+  /** 画面渲染器 */
+  frame: FrameKey;
+}
+
+export type FrameKey = 'visual-note' | 'whiteboard' | 'dark-notes' | 'guide-page' | 'card-digest';
+
+export type StageStatus = 'done' | 'running' | 'pending' | 'failed';
+
+export interface QcStage {
+  key: string;
+  label: string;
+  status: StageStatus;
+  /** 这一阶段在做什么，或做完后的结果 */
+  detail?: string;
+  /** 0-100，正在进行的阶段才有 */
+  progress?: number;
+}
+
+export interface QcQueueInfo {
+  position: number;
+  ahead: number;
+  running: number;
+  capacity: number;
+  /** 预计多少秒后开始 */
+  startInSec: number;
+}
+
+export interface QcScene {
+  index: number;
+  title: string;
+  /** 模板画面编号 */
+  frameScene: number;
+  startSec: number;
+  caption: string;
+  /** waiting 尚未开始；drawing 正在画；drawn 画好待配音；voicing 配音中；ready 已完成 */
+  status: 'ready' | 'drawing' | 'drawn' | 'voicing' | 'failed' | 'waiting';
+}
+
+export interface QcKeyPoint {
+  text: string;
+  /** 视频：跳转秒数；网页：页面锚点 */
+  atSec?: number;
+  anchor?: string;
+}
+
+export interface QcWebSection {
+  anchor: string;
+  title: string;
+  body: string;
+}
+
+export interface QcFailure {
+  stageKey: string;
+  /** 视频：第几幕；网页：第几节 */
+  unitIndex?: number;
+  /** 一句话说明，先说结果 */
+  message: string;
+  /** 已经保存下来的东西 */
+  saved: string[];
+  /** 可用的恢复动作 */
+  actions: Array<'retry-unit' | 'retry-step' | 'skip-unit' | 'requeue'>;
+}
+
+export type PublishStatus = 'none' | 'publishing' | 'failed' | 'done';
+
+export interface QcPublish {
+  status: PublishStatus;
+  siteTitle?: string;
+  /** 网页托管里的站点编号，用于定位 */
+  siteId?: string;
+  error?: string;
+  at?: string;
+}
+
+export type RunStatus = 'queued' | 'running' | 'failed' | 'done';
+
+export interface QcRun {
+  id: string;
+  title: string;
+  kind: OutputKind;
+  templateId: string;
+  ask: string;
+  attachments: QcAttachment[];
+  status: RunStatus;
+  queue?: QcQueueInfo;
+  stages: QcStage[];
+  elapsedSec: number;
+  /** 预计还需多少秒；给不出时为空 */
+  remainSec?: number;
+  /** 预计依据，例如「最近 20 次的中位数」 */
+  estimateBasis?: string;
+  failure?: QcFailure;
+  scenes?: QcScene[];
+  sections?: QcWebSection[];
+  durationSec?: number;
+  keyPoints?: QcKeyPoint[];
+  voice?: string;
+  /** 成片媒体（视频产出完成后才有）：播放器直接播放它，字幕与重点随 currentTime 切换 */
+  media?: { url: string; mime: string };
+  publish: QcPublish;
+  createdAt: string;
+  updatedAt: string;
+}
+
+export interface QcWork {
+  runId: string;
+  title: string;
+  kind: OutputKind;
+  templateId: string;
+  status: RunStatus;
+  publishStatus: PublishStatus;
+  /** 第二行：状态补充，例如「第 4 幕配音超时」 */
+  summary: string;
+  updatedAt: string;
+}
+
+export interface CreateRunInput {
+  kind: OutputKind;
+  templateId: string;
+  ask: string;
+  attachmentIds: string[];
+  title?: string;
+}
diff --git a/prd-admin/src/services/real/quickCreation.ts b/prd-admin/src/services/real/quickCreation.ts
new file mode 100644
index 00000000..abb1fd53
--- /dev/null
+++ b/prd-admin/src/services/real/quickCreation.ts
@@ -0,0 +1,66 @@
+import { apiRequest } from '@/services/real/apiClient';
+import { useAuthStore } from '@/stores/authStore';
+import { fail, type ApiResponse } from '@/types/api';
+import type { CreateRunInput, QcAttachment, QcRun, QcTemplate, QcWork } from '@/pages/quick-creation-agent/types';
+
+/**
+ * 快速创作接口。生成在服务端排队与执行（Run/Worker），离开页面不取消；页面按任务编号恢复。
+ * 统一走 apiRequest，响应以 success 判断；附件上传是 FormData，按约定直接 fetch。
+ */
+const base = '/api/quick-creation';
+
+export function listQuickCreationTemplates() {
+  return apiRequest<{ items: QcTemplate[] }>(`${base}/templates`);
+}
+
+export function listQuickCreationWorks() {
+  return apiRequest<{ items: QcWork[]; total: number }>(`${base}/works`);
+}
+
+export function getQuickCreationRun(runId: string) {
+  return apiRequest<QcRun>(`${base}/runs/${encodeURIComponent(runId)}`);
+}
+
+export function createQuickCreationRun(input: CreateRunInput) {
+  return apiRequest<QcRun>(`${base}/runs`, { method: 'POST', body: input });
+}
+
+/** 只重做失败的那一步或那一幕，已完成的部分保留 */
+export function retryQuickCreationRun(runId: string, input: { action: 'retry-unit' | 'retry-step' | 'skip-unit' | 'requeue'; unitIndex?: number }) {
+  return apiRequest<QcRun>(`${base}/runs/${encodeURIComponent(runId)}/retry`, { method: 'POST', body: input });
+}
+
+/** 发布到网页托管；重试只上传，不会重新生成 */
+export function publishQuickCreationRun(runId: string) {
+  return apiRequest<QcRun>(`${base}/runs/${encodeURIComponent(runId)}/publish`, { method: 'POST', body: {} });
+}
+
+export function addKnowledgeAttachment(entryId: string) {
+  return apiRequest<QcAttachment>(`${base}/attachments/knowledge`, { method: 'POST', body: { entryId } });
+}
+
+export function retryAttachmentRead(attachmentId: string) {
+  return apiRequest<QcAttachment>(`${base}/attachments/${encodeURIComponent(attachmentId)}/read`, { method: 'POST', body: {} });
+}
+
+/** 粘贴的长正文作为一份稿件附件保存，输入框只留给「要求」 */
+export function addTextAttachment(input: { name: string; text: string }) {
+  return apiRequest<QcAttachment>(`${base}/attachments/text`, { method: 'POST', body: input });
+}
+
+export async function uploadQuickCreationAttachment(file: File): Promise<ApiResponse<QcAttachment>> {
+  const token = useAuthStore.getState().token;
+  const fd = new FormData();
+  fd.append('file', file);
+  try {
+    const res = await fetch(`${base}/attachments`, {
+      method: 'POST',
+      headers: token ? { Authorization: `Bearer ${token}` } : {},
+      body: fd,
+      credentials: 'include',
+    });
+    return (await res.json()) as ApiResponse<QcAttachment>;
+  } catch {
+    return fail('NETWORK_ERROR', '上传没有完成，请检查网络后重试');
+  }
+}
