+/**
+ * 对话的两种说话人，一眼分得清：
+ * - 你：靠右的主色浅底气泡，资料卡收在气泡里，下方一行写产出与模板；
+ * - 快速创作：靠左，带头像与名字，不套气泡；它的状态（已保存、排队、进度、失败、完成）都是这一轮里的卡片，
+ *   不再和你的消息交错成一列。
+ */
+import type { ReactNode } from 'react';
+import { Sparkles } from 'lucide-react';
+
+export function AgentTurn({ children, status }: { children: ReactNode; status?: ReactNode }) {
+  return (
+    <div className="qc-rise flex gap-2.5" data-turn="agent">
+      <span className="mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-[9px] bg-[color:var(--accent-primary)] text-[color:var(--accent-on-primary)]" aria-hidden>
+        <Sparkles size={14} />
+      </span>
+      <div className="min-w-0 flex-1">
+        <div className="flex h-7 items-center gap-2 text-[12.5px]">
+          <span className="font-medium text-token-primary">快速创作</span>
+          {status && <span className="min-w-0 truncate text-token-muted">{status}</span>}
+        </div>
+        <div className="mt-1 flex flex-col gap-3">{children}</div>
+      </div>
+    </div>
+  );
+}
+
+export function UserTurn({ children, meta }: { children: ReactNode; meta?: ReactNode }) {
+  return (
+    <div className="qc-rise ml-auto flex w-full max-w-[92%] flex-col items-end gap-1.5" data-turn="user">
+      {/* 气泡按内容收宽：一句话就一句话的宽，带资料卡时才撑开 */}
+      <div className="flex w-fit max-w-full flex-col gap-2.5 rounded-[18px_18px_4px_18px] bg-[var(--selection-bg)] px-3 py-2.5">{children}</div>
+      {meta && <div className="flex items-center gap-1.5 px-1 text-[11.5px] text-token-muted">{meta}</div>}
+    </div>
+  );
+}
diff --git a/prd-admin/src/pages/quick-creation-agent/Duration.tsx b/prd-admin/src/pages/quick-creation-agent/Duration.tsx
new file mode 100644
index 00000000..700a3a7b
--- /dev/null
+++ b/prd-admin/src/pages/quick-creation-agent/Duration.tsx
@@ -0,0 +1,76 @@
+/**
+ * 成片时长：开工前就让人知道「大概多长」，也能自己定。
+ * - 自动：服务端按内容估算（稿件全文照念多长、取多少讲重点），选项上直接写出估算值，不写空泛的「自动」；
+ * - 指定：约 1 / 3 / 5 / 10 分钟。服务端按目标决定幕数与旁白字数，并校验脚本总时长落在目标的 ±15%。
+ * 估算值来自 POST /api/quick-creation/estimate，前端只显示。
+ * 选项放在「时长 · 风格」按钮的面板顶部：时长、风格都是「怎么做这一支」，收在同一个按钮里，输入框不再多一个按钮。
+ */
+import { Check } from 'lucide-react';
+import { cn } from '@/lib/cn';
+import type { DurationChoice, QcEstimate } from './types';
+
+const OPTIONS: { value: DurationChoice; label: string; hint: string }[] = [
+  { value: 'auto', label: '自动', hint: '按内容估算' },
+  { value: 60, label: '约 1 分钟', hint: '讲重点' },
+  { value: 180, label: '约 3 分钟', hint: '讲清楚' },
+  { value: 300, label: '约 5 分钟', hint: '一步步教' },
+  { value: 600, label: '约 10 分钟', hint: '完整课程' },
+];
+
+export const minutesLabel = (sec: number) => (sec < 60 ? `${sec} 秒` : `${Math.round(sec / 60)} 分钟`);
+/** 按钮上的短写：自动时直接写估算值 */
+export function durationShort(value: DurationChoice, estimate?: QcEstimate | null) {
+  const sec = value === 'auto' ? estimate?.autoSec : value;
+  return sec ? `约 ${minutesLabel(sec)}` : '时长';
+}
+
+/** 时长选项：桌面在时长按钮的面板里，手机在「视频 · 风格」面板顶部 */
+export function DurationOptions({ value, estimate, onChange, compact }: { value: DurationChoice; estimate?: QcEstimate | null; onChange: (v: DurationChoice) => void; compact?: boolean }) {
+  return (
+    <div>
+      <div role="radiogroup" aria-label="成片时长" className={cn(compact ? 'flex gap-1.5 overflow-x-auto pb-0.5' : 'flex flex-col gap-0.5')} style={compact ? { scrollbarWidth: 'none' } : undefined}>
+        {OPTIONS.map(o => {
+          const on = o.value === value;
+          const label = o.value === 'auto' && estimate ? `自动 · 约 ${minutesLabel(estimate.autoSec)}` : o.label;
+          return compact ? (
+            <button key={String(o.value)} type="button" role="radio" aria-checked={on} data-qc="duration-option" data-value={String(o.value)} onClick={() => onChange(o.value)}
+              className={cn('qc-face qc-face-chip relative inline-flex shrink-0 items-center px-3 text-[12.5px]', on ? 'font-medium text-[color:var(--accent-primary)]' : 'text-token-primary')}>
+              {label}
+            </button>
+          ) : (
+            <button key={String(o.value)} type="button" role="radio" aria-checked={on} data-qc="duration-option" data-value={String(o.value)} onClick={() => onChange(o.value)}
+              className={cn('flex min-h-9 items-center gap-2 rounded-lg px-2.5 text-left text-[13px] hover-bg-soft', on && 'bg-[var(--selection-bg)]')}>
+              <span className="min-w-0 flex-1 text-token-primary">{label}</span>
+              <span className="shrink-0 text-[12px] text-token-muted">{o.hint}</span>
+              <Check size={14} className={cn('shrink-0 text-[color:var(--accent-primary)]', !on && 'invisible')} aria-hidden />
+            </button>
+          );
+        })}
+      </div>
+      {estimate && (
+        <p className="m-0 mt-2 text-[12px] leading-[18px] text-token-secondary" data-qc="duration-basis">
+          {estimate.basis}。分成约 {estimate.scenes} 幕，生成约 {estimate.generateMin[0]}–{estimate.generateMin[1]} 分钟。
+        </p>
+      )}
+    </div>
+  );
+}
+
+/**
+ * 先试看：只做片头和第 1 幕（带配音），满意再做完。3 分钟及以上默认开：越长，方向不对时白做得越多。
+ * 用户手动改过就以用户为准，不再随时长自动变。
+ */
+export function TrialToggle({ on, estimate, onChange }: { on: boolean; estimate?: QcEstimate | null; onChange: (v: boolean) => void }) {
+  return (
+    <button type="button" role="switch" aria-checked={on} data-qc="trial-toggle" onClick={() => onChange(!on)}
+      className="flex min-h-11 w-full items-center gap-2.5 rounded-lg px-1 text-left hover-bg-soft md:min-h-9">
+      <span aria-hidden className={cn('relative inline-flex h-[18px] w-8 shrink-0 rounded-full transition-colors', on ? 'bg-[var(--accent-primary)]' : 'bg-[var(--border-default)]')}>
+        <span className={cn('absolute top-[2px] h-[14px] w-[14px] rounded-full bg-[var(--bg-input)] shadow-sm transition-[left]', on ? 'left-[16px]' : 'left-[2px]')} />
+      </span>
+      <span className="min-w-0 flex-1">
+        <span className="block text-[12.5px] text-token-primary">先试看片头和第 1 幕，满意再做完</span>
+        <span className="block text-[11.5px] text-token-muted">{estimate ? `约 ${estimate.trialMin[0]}–${estimate.trialMin[1]} 分钟出试看；` : ''}方向不对时只白做一成</span>
+      </span>
+    </button>
+  );
+}
diff --git a/prd-admin/src/pages/quick-creation-agent/Landing.tsx b/prd-admin/src/pages/quick-creation-agent/Landing.tsx
new file mode 100644
index 00000000..13cb7322
--- /dev/null
+++ b/prd-admin/src/pages/quick-creation-agent/Landing.tsx
@@ -0,0 +1,190 @@
+/**
+ * 新建页（还没开始对话、也没有任务时）：居中一列，输入框是主角。
+ * - 输入框下面：几个起头（放稿件或直接开聊），安静的文字按钮；
+ * - 风格灵感：一排大海报，点一下就换成这个风格；「全部 99 种」打开风格库浮层；
+ * - 最近作品：历史就在这里，不用去右上角找。「我的」列出全部任务（含进行中、失败），「团队」列出同事的成品。
+ * 不套卡片：海报自己就是视觉重点，文字直接排在下面，靠留白分组。
+ */
+import { useEffect, useState } from 'react';
+import * as Dialog from '@radix-ui/react-dialog';
+import { ArrowRight, ExternalLink, FolderOpen, Globe, Palette, Video, X } from 'lucide-react';
+import { cn } from '@/lib/cn';
+import { MapSpinner } from '@/components/ui/VideoLoader';
+import { listQuickCreationAssets } from '@/services/real/quickCreation';
+import { StyleFrame } from './TemplateFrames';
+import { formatClock } from './format';
+import type { QcAsset, QcTemplate, QcWork } from './types';
+
+/** 通用浮层：风格库、资料管理、团队成品详情都用它；不另起页面，关掉就回到原处 */
+export function Sheet({ open, onOpenChange, title, qc, wide, attrs, children }: { open: boolean; onOpenChange: (v: boolean) => void; title: string; qc: string; wide?: boolean; attrs?: Record<string, string | undefined>; children: React.ReactNode }) {
+  return (
+    <Dialog.Root open={open} onOpenChange={onOpenChange}>
+      <Dialog.Portal>
+        <Dialog.Overlay className="fixed inset-0 z-[100] bg-[var(--hosting-scrim)]" />
+        <Dialog.Content data-qc={qc} aria-describedby={undefined} {...attrs}
+          className={cn('qc-menu-surface fixed left-1/2 top-1/2 z-[101] flex -translate-x-1/2 -translate-y-1/2 flex-col overflow-hidden rounded-2xl shadow-2xl',
+            wide ? 'h-[min(86vh,820px)] w-[min(1100px,calc(100vw-24px))]' : 'max-h-[86vh] w-[min(720px,calc(100vw-24px))]')}>
+          <div className="flex shrink-0 items-center justify-between gap-3 px-5 pb-2 pt-4">
+            <Dialog.Title className="m-0 text-[16px] font-semibold text-token-primary">{title}</Dialog.Title>
+            <Dialog.Close className="qc-icon-btn" aria-label="关闭"><X size={17} /></Dialog.Close>
+          </div>
+          <div className="min-h-0 flex-1 overflow-y-auto" style={{ overscrollBehavior: 'contain' }}>{children}</div>
+        </Dialog.Content>
+      </Dialog.Portal>
+    </Dialog.Root>
+  );
+}
+
+/** 起头：放稿件的两种方式 + 直接开聊的三句话 */
+export function Starters({ onSample, onKnowledge, onSay, showSay }: { onSample: () => void; onKnowledge: () => void; onSay: (t: string) => void; showSay: boolean }) {
+  const chip = 'qc-face qc-face-quiet relative inline-flex items-center px-3 text-[13px] text-token-secondary';
+  return (
+    <div className="mt-4 flex flex-wrap items-center justify-center gap-x-1.5 gap-y-1" aria-label="从这里开始">
+      <button type="button" data-qc="sample-doc" className={chip} onClick={onSample}>用示例稿件试一下</button>
+      <button type="button" data-qc="pick-knowledge" className={chip} onClick={onKnowledge}>从知识库选</button>
+      {showSay && ['我想做一个宣传片', '给新同事做个培训短片', '不知道选什么风格'].map(t => (
+        <button key={t} type="button" data-qc="starter" data-value={t} className={chip} onClick={() => onSay(t)}>{t}</button>
+      ))}
+    </div>
+  );
+}
+
+function SectionHead({ title, action }: { title: string; action?: React.ReactNode }) {
+  return (
+    <div className="mb-3 flex items-end justify-between gap-3">
+      <h2 className="m-0 text-[15px] font-semibold tracking-tight text-token-primary">{title}</h2>
+      {action}
+    </div>
+  );
+}
+
+const linkCls = 'inline-flex min-h-8 items-center gap-1 rounded-md text-[13px] text-token-secondary hover:text-token-primary max-md:min-h-11';
+
+/** 风格灵感：每类取一种做海报，横向滑动；点一下换风格 */
+export function StyleInspiration({ templates, selectedId, onSelect, onBrowseAll }: { templates: QcTemplate[]; selectedId?: string; onSelect: (id: string) => void; onBrowseAll: () => void }) {
+  const picks: QcTemplate[] = [];
+  for (const t of templates) if (!picks.some(p => p.categoryId === t.categoryId)) picks.push(t);
+  return (
+    <section className="mt-14" aria-label="风格灵感" data-qc="style-inspiration">
+      <SectionHead title="风格灵感" action={<button type="button" className={linkCls} data-qc="style-library-open" onClick={onBrowseAll}>全部 {templates.length} 种<ArrowRight size={14} /></button>} />
+      <div role="radiogroup" aria-label="挑一个风格" className="flex snap-x gap-4 overflow-x-auto pb-2" style={{ scrollbarWidth: 'none' }}>
+        {picks.slice(0, 10).map(t => {
+          const on = t.id === selectedId;
+          return (
+            <button key={t.id} type="button" role="radio" aria-checked={on} data-style={t.id} onClick={() => onSelect(t.id)}
+              className="group w-[200px] shrink-0 snap-start text-left max-md:w-[160px]">
+              <span className={cn('block overflow-hidden rounded-xl transition-[box-shadow,transform] duration-200 group-hover:-translate-y-0.5', on ? 'shadow-[0_0_0_2px_var(--accent-primary)]' : 'shadow-[var(--shadow-card-sm)]')}>
+                <StyleFrame template={{ ...t, frame: undefined }} />
+              </span>
+              <span className={cn('mt-2.5 block truncate text-[13px] font-medium', on ? 'text-[color:var(--accent-primary)]' : 'text-token-primary')}>{t.name}</span>
+              <span className="block truncate text-[12px] text-token-muted">{t.line}</span>
+            </button>
+          );
+        })}
+      </div>
+    </section>
+  );
+}
+
+function workStatus(w: QcWork): { text: string; tone: 'live' | 'warn' | 'muted' } | null {
+  if (w.status === 'queued') return { text: '排队中', tone: 'live' };
+  if (w.status === 'running') return { text: '生成中', tone: 'live' };
+  if (w.status === 'failed') return { text: '需要处理', tone: 'warn' };
+  if (w.publishStatus === 'done') return { text: '已发布', tone: 'muted' };
+  return null;
+}
+
+function Poster({ template }: { template?: QcTemplate }) {
+  return template ? <StyleFrame template={{ ...template, frame: undefined }} /> : <span className="block aspect-video bg-[var(--bg-tertiary)]" />;
+}
+
+/** 最近作品：历史就在新建页上。我的 = 全部任务；团队 = 同事做好的成品（点开可以把风格带回来） */
+export function RecentWorks({ works, templates, onOpenWork, onAllWorks, onUseStyle, onOpenAsset, onOpenHosting, currentStyleId }: {
+  works: QcWork[];
+  templates: QcTemplate[];
+  onOpenWork: (runId: string) => void;
+  onAllWorks: () => void;
+  onUseStyle: (a: QcAsset) => void;
+  onOpenAsset: (a: QcAsset) => void;
+  onOpenHosting: (a: QcAsset) => void;
+  currentStyleId?: string;
+}) {
+  const [tab, setTab] = useState<'mine' | 'team'>('mine');
+  const [team, setTeam] = useState<QcAsset[] | null>(null);
+  const [detail, setDetail] = useState<QcAsset | null>(null);
+  useEffect(() => {
+    if (tab !== 'team' || team) return;
+    void listQuickCreationAssets('team').then(res => setTeam(res.success ? res.data.items.filter(a => !a.mine) : []));
+  }, [tab, team]);
+  const style = (id: string) => templates.find(t => t.id === id);
