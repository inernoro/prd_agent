{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "LlmGateway": {
    "MinimumProtection": {
      "TenantPerMinute": 600,
      "TenantPerHour": 6000,
      "TenantPerDay": 20000,
      "AppCallerPerMinute": 120,
      "AppCallerPerHour": 1000,
      "AppCallerPerDay": 5000,
      "AutomaticTenantPerMinute": 60,
      "AutomaticTenantPerHour": 300,
      "AutomaticTenantPerDay": 1500,
      "AutomaticAppCallerPerMinute": 20,
      "AutomaticAppCallerPerHour": 100,
      "AutomaticAppCallerPerDay": 500,
      "WarningPercent": 80
    },
    "RuntimeSettings": {
      "BootstrapFromMap": true,
      "MapBootstrapTimeoutSeconds": 2
    },
    "Retention": {
      "WorkerEnabled": true,
      "ApplyChanges": false,
      "EnableTtlIndexes": false,
      "RequestLogDays": 90,
      "SensitiveBodyDays": 7,
      "AuditDays": 180,
      "SuccessfulMultipartHours": 24,
      "FailedMultipartHours": 72
    }
  }
}
